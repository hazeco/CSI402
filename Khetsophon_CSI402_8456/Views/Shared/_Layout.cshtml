@using Khetsophon_CSI402_8456.Controllers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Khetsophon_CSI402_8456</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Khetsophon_CSI402_8456.styles.css" asp-append-version="true" />
</head>
<body class="flex  flex-col bg-gray-50 text-gray-900">
    <header>
        @await Component.InvokeAsync("Navbar")
    </header>

    <div class="mx-auto w-full max-w-6xl flex-1 sm:px-6">
        <main role="main" class="min-h-dvh">
            @RenderBody()
        </main>
    </div>
    @await Component.InvokeAsync("Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
