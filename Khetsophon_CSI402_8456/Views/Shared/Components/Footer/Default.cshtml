@{
    var figuretLinks = new[]
    {
        new { Label = "ฟิกเกอร์", Href = "#" },
        new { Label = "ของสะสม", Href = "#" },
        new { Label = "สินค้าใหม่", Href = "#" }
    };

    var platformLinks = new[]
    {
        new { Label = "เกี่ยวกับเรา", Href = "#" },
        new { Label = "วิธีใช้งาน", Href = "#" },
        new { Label = "ติดต่อเรา", Href = "#" }
    };

    var siteName = "FriendHouse";
    var lineId = "your-line-id";
    var contactEmail = "contact@example.com";
}

<footer class="border-t border-gray-200 bg-white px-4 pt-10 pb-8 text-gray-700">
    <div class="mx-auto max-w-7xl">
        <div class="mb-10 grid grid-cols-1 gap-9 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <div class="mb-4 flex items-center gap-2 text-xl font-bold text-text sm:text-2xl">
                    <span
                    class="flex size-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white">FH</span>
                    <span>FriendHouse</span>
                </div>

                <p class="max-w-260px text-sm leading-7 text-gray-500">
                    ร้านฟิกเกอร์และของสะสมสำหรับคนรักอนิเมะ จองล่วงหน้า รับและชำระเงินที่หน้าร้าน
                </p>
            </div>

            <div>
                <h4 class="mb-4 font-semibold">ฟิกเกอร์</h4>

                <ul class="space-y-2 text-sm text-gray-500">
                    @foreach (var link in figuretLinks)
                    {
                        <li>
                            <a href="@link.Href" class="hover:text-blue-700">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div>
                <h4 class="mb-4 font-semibold">แพลตฟอร์ม</h4>

                <ul class="space-y-2 text-sm text-gray-500">
                    @foreach (var link in platformLinks)
                    {
                        <li>
                            <a href="@link.Href" class="hover:text-blue-700">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div>
                <h4 class="mb-4 font-semibold">ติดต่อ</h4>

                <ul class="space-y-2 text-sm text-gray-500">
                    <li>
                        <a href="https://line.me/R/ti/p/@lineId" target="_blank" rel="noreferrer"
                           class="hover:text-blue-700">
                            LINE: @lineId
                        </a>
                    </li>
                    <li>@contactEmail</li>
                </ul>
            </div>
        </div>

        <div
            class="flex flex-col gap-3 border-t border-gray-200 pt-6 text-sm text-gray-500 sm:flex-row sm:items-center sm:justify-between">
            <span>
                &copy; @DateTime.Now.Year @siteName. All rights reserved.
            </span>
            <span>จองล่วงหน้า รับและชำระเงินที่หน้าร้าน เท่านั้น</span>
        </div>
    </div>
</footer>