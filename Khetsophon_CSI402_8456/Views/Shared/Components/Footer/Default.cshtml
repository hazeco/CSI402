@{
    var artistLinks = new[]
    {
        new { Label = "...", Href = "#" },
        new { Label = "...", Href = "#" },
        new { Label = "...", Href = "#" }
    };

    var platformLinks = new[]
    {
        new { Label = "เกี่ยวกับเรา", Href = "#" },
        new { Label = "วิธีใช้งาน", Href = "#" },
        new { Label = "ติดต่อเรา", Href = "#" }
    };

    var siteName = "...";
    var lineId = "your-line-id";
    var contactEmail = "contact@example.com";
}

<footer class="border-t border-gray-200 bg-white px-4 pt-10 pb-8 text-gray-700">
    <div class="mx-auto max-w-7xl">
        <div class="mb-10 grid grid-cols-1 gap-9 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <div class="mb-4 flex items-center gap-2 text-xl font-bold text-blue-700">
                    <span class="flex size-8 items-center justify-center rounded-lg bg-blue-600 text-sm font-bold text-white">FH</span>
                    <span>FriendHouse</span>
                </div>

                <p class="max-w-260px text-sm leading-7 text-gray-500">
                    Lorem ipsum dolor sit, amet consectetur adipisicing elit. Odio error fuga aliquid distinctio incidunt! Tempora officia ipsum neque omnis reprehenderit voluptates, ut, sed ab blanditiis voluptatem fuga libero vel quaerat.
                </p>
            </div>

            <div>
                <h4 class="mb-4 font-semibold">...</h4>

                <ul class="space-y-2 text-sm text-gray-500">
                    @foreach (var link in artistLinks)
                    {
                        <li>
                            <a href="@link.Href" class="hover:text-blue-700">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div>
                <h4 class="mb-4 font-semibold">แพลตฟอร์ม</h4>

                <ul class="space-y-2 text-sm text-gray-500">
                    @foreach (var link in platformLinks)
                    {
                        <li>
                            <a href="@link.Href" class="hover:text-blue-700">
                                @link.Label
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div>
                <h4 class="mb-4 font-semibold">ติดต่อ</h4>

                <ul class="space-y-2 text-sm text-gray-500">
                    <li>
                        <a href="https://line.me/R/ti/p/@lineId"
                           target="_blank"
                           rel="noreferrer"
                           class="hover:text-blue-700">
                            LINE: @lineId
                        </a>
                    </li>
                    <li>@contactEmail</li>
                </ul>
            </div>
        </div>

        <div class="flex flex-col gap-3 border-t border-gray-200 pt-6 text-sm text-gray-500 sm:flex-row sm:items-center sm:justify-between">
            <span>
                &copy; @DateTime.Now.Year @siteName. All rights reserved.
            </span>
            <span>..................</span>
        </div>
    </div>
</footer>