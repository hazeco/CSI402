@{
    var brand = new {
        LogoUrl = "~/logo/logo.png",
        Name = "FriendHouse",
        UserName = "ปวีณา รักษ์บัญชี",
        UserRole = "คนทำบัญชี"
    };

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string action)
    {
        bool isActive = currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "px-4 py-2 rounded-xl bg-[#3E4AB8] text-white font-semibold text-sm transition-all"
            : "px-4 py-2 rounded-xl hover:bg-white/10 text-white/80 hover:text-white font-medium text-sm transition-all";
    }
}

<div class="bg-[#2F39A9] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <!-- Brand (frame_9_23.png) -->
        <a asp-controller="Accountant" asp-action="Index" class="flex items-center gap-3 shrink-0 cursor-pointer">
            <div class="size-9 rounded-xl overflow-hidden bg-white shadow-xs flex items-center justify-center shrink-0">
                <img src="@Url.Content(brand.LogoUrl)" alt="@brand.Name" class="size-full object-cover" onerror="this.outerHTML='<span class=\'text-[#2F39A9] font-black text-xs\'>FH</span>'" />
            </div>
            <span class="font-bold leading-tight text-base tracking-tight text-white">@brand.Name</span>
        </a>

        <!-- Center Nav Items (frame_9_23.png: แดชบอร์ดการเงิน, บันทึกรายรับ-รายจ่าย, ประวัติใบเสร็จ) -->
        <nav class="hidden md:flex items-center gap-2">
            <a asp-controller="Accountant" asp-action="Index" class="@NavClass("Index")">
                <span>แดชบอร์ดการเงิน</span>
            </a>
            <a asp-controller="Accountant" asp-action="Ledger" class="@NavClass("Ledger")">
                <span>บันทึกรายรับ-รายจ่าย</span>
            </a>
            <a asp-controller="Accountant" asp-action="Receipts" class="@NavClass("Receipts")">
                <span>ประวัติใบเสร็จ</span>
            </a>
        </nav>

        <!-- Right User (frame_9_23.png: ปวีณา รักษ์บัญชี / คนทำบัญชี) -->
        <div class="flex items-center gap-3">
            <div class="size-9 rounded-full bg-[#BAF2FF] text-[#2F39A9] flex items-center justify-center shadow-xs">
                <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            <div class="hidden sm:block text-left">
                <div class="text-xs font-bold leading-tight text-white">@brand.UserName</div>
                <div class="text-[10px] text-white/70 leading-tight">@brand.UserRole</div>
            </div>
        </div>
    </div>

    <!-- Mobile Sub-navigation Bar -->
    <div class="md:hidden border-t border-white/10 px-4 py-2 flex items-center gap-2 overflow-x-auto">
        <a asp-controller="Accountant" asp-action="Index" class="@NavClass("Index") text-xs py-1.5 px-3 shrink-0">แดชบอร์ดการเงิน</a>
        <a asp-controller="Accountant" asp-action="Ledger" class="@NavClass("Ledger") text-xs py-1.5 px-3 shrink-0">บันทึกรายรับ-รายจ่าย</a>
        <a asp-controller="Accountant" asp-action="Receipts" class="@NavClass("Receipts") text-xs py-1.5 px-3 shrink-0">ประวัติใบเสร็จ</a>
    </div>
</div>
