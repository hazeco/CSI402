@{
    var brand = new {
        LogoUrl = "~/logo/logo.png",
        Name = "FriendHouse",
        Subtitle = "ระบบบัญชีและการเงิน",
        NotificationCount = 1,
        UserName = "ปวีณา รักษ์บัญชี",
        UserRole = "คนทำบัญชี",
        UserInitials = "ปร"
    };

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string controller, string action)
    {
        bool isActive = currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) &&
                        currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "px-3.5 py-2 rounded-xl bg-white/20 flex items-center gap-2 text-white font-semibold text-sm shadow-xs transition-all"
            : "px-3.5 py-2 rounded-xl hover:bg-white/10 flex items-center gap-2 text-white/80 hover:text-white font-medium text-sm transition-all";
    }
}

<header class="bg-primary text-white shadow-sm shrink-0 border-b border-white/10 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-4">
        <!-- Brand & System Role -->
        <div class="flex items-center gap-3 shrink-0">
            <div class="size-10 rounded-xl overflow-hidden border border-white/20 bg-white shadow-xs flex items-center justify-center shrink-0">
                <img src="@Url.Content(brand.LogoUrl)" alt="@brand.Name" class="size-full object-cover" />
            </div>
            <div>
                <div class="font-bold leading-tight text-base tracking-tight">@brand.Name</div>
                <div class="text-[11px] text-white/70 leading-tight">@brand.Subtitle</div>
            </div>
        </div>

        <!-- Center Nav Items -->
        <nav class="hidden md:flex items-center gap-2">
            <a asp-controller="Accountant" asp-action="Index" class="@NavClass("Accountant", "Index")">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
                <span>แดชบอร์ดการเงิน</span>
            </a>
            <a asp-controller="Accountant" asp-action="Ledger" class="@NavClass("Accountant", "Ledger")">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                <span>บันทึกรายรับ-รายจ่าย</span>
            </a>
            <a asp-controller="Accountant" asp-action="Receipts" class="@NavClass("Accountant", "Receipts")">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>ประวัติใบเสร็จ</span>
            </a>
        </nav>

        <!-- Right User & Notifications -->
        <div class="flex items-center gap-3">
            <button type="button" class="relative size-9 rounded-xl hover:bg-white/10 flex items-center justify-center text-white/90 hover:text-white transition cursor-pointer" aria-label="การแจ้งเตือน">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span class="absolute top-1 right-1 size-4 bg-accent text-white text-[10px] font-bold rounded-full flex items-center justify-center">@brand.NotificationCount</span>
            </button>

            <div class="flex items-center gap-2.5 pl-2 border-l border-white/15">
                <div class="size-8 rounded-full bg-white/20 text-white font-bold text-xs flex items-center justify-center border border-white/30">
                    @brand.UserInitials
                </div>
                <div class="hidden sm:block text-left">
                    <div class="text-xs font-semibold leading-tight text-white">@brand.UserName</div>
                    <div class="text-[10px] text-white/70 leading-tight">@brand.UserRole</div>
                </div>
            </div>
        </div>
    </div>
</header>
