@{
    var brand = new {
        LogoUrl = "~/logo/logo.png",
        Name = "FriendHouse",
        UserName = "จอห์น หงษ์ทอง",
        UserRole = "เจ้าของร้าน",
        UserInitials = "จอ"
    };

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string action)
    {
        bool isActive = currentAction.Equals(action, StringComparison.OrdinalIgnoreCase) ||
                        (action == "Promotions" && (currentAction == "AddPromotion" || currentAction == "EditPromotion" || currentAction == "Index"));
        return isActive
            ? "px-4 py-2 rounded-xl bg-[#3E4AB8] text-white font-semibold text-sm transition-all"
            : "px-4 py-2 rounded-xl hover:bg-white/10 text-white/80 hover:text-white font-medium text-sm transition-all";
    }
}

<div class="bg-[#2F39A9] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <!-- Brand -->
        <a asp-controller="Owner" asp-action="Promotions" class="flex items-center gap-3 shrink-0 cursor-pointer">
            <div class="size-9 rounded-xl overflow-hidden bg-white shadow-xs flex items-center justify-center shrink-0">
                <img src="@Url.Content(brand.LogoUrl)" alt="@brand.Name" class="size-full object-cover" onerror="this.outerHTML='<span class=\'text-[#2F39A9] font-black text-xs\'>FH</span>'" />
            </div>
            <span class="font-bold leading-tight text-base tracking-tight text-white">@brand.Name</span>
        </a>

        <!-- Center Nav Items (Figma frame_9_7.png) -->
        <nav class="hidden md:flex items-center gap-2">
            <a asp-controller="Owner" asp-action="Promotions" class="@NavClass("Promotions")">
                <span>โปรโมชั่น</span>
            </a>
            <a asp-controller="Owner" asp-action="MonthlyReport" class="@NavClass("MonthlyReport")">
                <span>รายงาน</span>
            </a>
        </nav>

        <!-- Right User (Figma frame_9_7.png: "จอห์น หงษ์ทอง / เจ้าของร้าน", initials "จอ") -->
        <div class="flex items-center gap-3">
            <div class="size-9 rounded-full bg-[#3E4AB8] text-white font-bold text-xs flex items-center justify-center shadow-xs">
                @brand.UserInitials
            </div>
            <div class="hidden sm:block text-left">
                <div class="text-xs font-bold leading-tight text-white">@brand.UserName</div>
                <div class="text-[10px] text-white/70 leading-tight">@brand.UserRole</div>
            </div>
        </div>
    </div>

    <!-- Mobile Sub-navigation Bar -->
    <div class="md:hidden border-t border-white/10 px-4 py-2 flex items-center gap-2 overflow-x-auto">
        <a asp-controller="Owner" asp-action="Promotions" class="@NavClass("Promotions") text-xs py-1.5 px-3 shrink-0">โปรโมชั่น</a>
        <a asp-controller="Owner" asp-action="MonthlyReport" class="@NavClass("MonthlyReport") text-xs py-1.5 px-3 shrink-0">รายงาน</a>
    </div>
</div>
