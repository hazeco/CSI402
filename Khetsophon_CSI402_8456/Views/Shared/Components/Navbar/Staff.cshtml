@{
    var brand = new {
        LogoUrl = "~/logo/logo.png",
        Name = "FriendHouse",
        Subtitle = "ระบบจัดการสต็อก · หน้าร้าน",
        NotificationCount = 3,
        UserName = "ณัฐชา ใจดี",
        UserRole = "พนักงาน",
        UserInitials = "ณช"
    };

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string action)
    {
        bool isActive = currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "px-4 py-2 rounded-xl bg-[#3E4AB8] text-white font-semibold text-sm transition-all"
            : "px-4 py-2 rounded-xl hover:bg-white/10 text-white/80 hover:text-white font-medium text-sm transition-all";
    }
}

<div class="bg-[#2F39A9] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <!-- Brand & System Role -->
        <a asp-controller="Staff" asp-action="Index" class="flex items-center gap-3 shrink-0 cursor-pointer">
            <div class="size-9 rounded-xl overflow-hidden bg-white shadow-xs flex items-center justify-center shrink-0">
                <img src="@Url.Content(brand.LogoUrl)" alt="@brand.Name" class="size-full object-cover" onerror="this.outerHTML='<span class=\'text-[#2F39A9] font-black text-xs\'>FH</span>'" />
            </div>
            <div>
                <div class="font-bold leading-tight text-sm tracking-tight text-white">@brand.Name</div>
                <div class="text-[11px] text-white/75 leading-tight">@brand.Subtitle</div>
            </div>
        </a>

        <!-- Center Nav Items (Figma Pill Design) -->
        <nav class="hidden md:flex items-center gap-2">
            <a asp-controller="Staff" asp-action="Index" class="@NavClass("Index")">
                <span>สต็อกสินค้า</span>
            </a>
            <a asp-controller="Staff" asp-action="ScanReceive" class="@NavClass("ScanReceive")">
                <span>สแกนรับสินค้า</span>
            </a>
            <a asp-controller="Staff" asp-action="CounterPreorder" class="@NavClass("CounterPreorder")">
                <span>เคาน์เตอร์พรีออเดอร์</span>
            </a>
        </nav>

        <!-- Right User & Notifications -->
        <div class="flex items-center gap-3.5">
            <!-- Notification Bell with Red Badge -->
            <button type="button" class="relative size-9 rounded-xl hover:bg-white/10 flex items-center justify-center text-white/90 hover:text-white transition cursor-pointer" aria-label="การแจ้งเตือน">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span class="absolute top-1 right-1 size-4 bg-[#EF4444] text-white text-[10px] font-bold rounded-full flex items-center justify-center shadow-xs">@brand.NotificationCount</span>
            </button>

            <!-- User Info Capsule -->
            <div class="flex items-center gap-2.5">
                <div class="size-8 rounded-full bg-white text-[#2F39A9] font-bold text-xs flex items-center justify-center shadow-xs">
                    @brand.UserInitials
                </div>
                <div class="hidden sm:block text-left">
                    <div class="text-xs font-bold leading-tight text-white">@brand.UserName</div>
                    <div class="text-[10px] text-white/70 leading-tight">@brand.UserRole</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Sub-navigation Bar -->
    <div class="md:hidden border-t border-white/10 px-4 py-2 flex items-center gap-2 overflow-x-auto">
        <a asp-controller="Staff" asp-action="Index" class="@NavClass("Index") text-xs py-1.5 px-3 shrink-0">สต็อกสินค้า</a>
        <a asp-controller="Staff" asp-action="ScanReceive" class="@NavClass("ScanReceive") text-xs py-1.5 px-3 shrink-0">สแกนรับสินค้า</a>
        <a asp-controller="Staff" asp-action="CounterPreorder" class="@NavClass("CounterPreorder") text-xs py-1.5 px-3 shrink-0">เคาน์เตอร์พรีออเดอร์</a>
    </div>
</div>