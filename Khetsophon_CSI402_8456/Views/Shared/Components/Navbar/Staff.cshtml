@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string NavClass(string controller, string action)
    {
        bool isActive = currentController == controller && currentAction == action;
        return isActive
            ? "px-3 py-2 rounded-lg bg-white/15 flex items-center gap-1.5 text-white"
            : "px-3 py-2 rounded-lg hover:bg-white/10 flex items-center gap-1.5 text-white/85";
    }
}
<header class="bg-primary text-white shadow-md shrink-0">
    <div class="px-6 py-3 flex items-center justify-between border-b border-white/10">
        <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-lg bg-white/15 flex items-center justify-center font-bold text-base">FH</div>
            <div>
                <div class="font-bold leading-tight text-[15px]">FriendHouse</div>
                <div class="text-[11px] text-white/70 leading-tight">ระบบจัดการสต็อก · หน้าร้าน</div>
            </div>
        </div>

        <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
            <a asp-controller="Staff" asp-action="Index" class="@NavClass("Staff", "Index")">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8L12 3 3 8v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
                สต็อกสินค้า
            </a>
            <a asp-controller="Staff" asp-action="ScanReceive" class="@NavClass("Staff", "ScanReceive")">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/><path d="M3 12h18"/></svg>
                สแกนรับสินค้า
            </a>
            <a asp-controller="Staff" asp-action="CounterPreorder" class="@NavClass("Staff", "CounterPreorder")">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                เคาน์เตอร์พรีออเดอร์
            </a>
        </nav>

        <div class="flex items-center gap-3">
            <button class="relative w-9 h-9 rounded-full bg-white/10 hover:bg-white/15 flex items-center justify-center">
                <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 00-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
                <span class="absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-accent text-[9px] font-bold flex items-center justify-center ring-2 ring-primary">3</span>
            </button>
            <div class="flex items-center gap-2 bg-white/10 rounded-full pl-1 pr-3 py-1">
                <div class="w-7 h-7 rounded-full bg-secondary/30 text-white flex items-center justify-center text-xs font-bold shrink-0">ณช</div>
                <div class="text-xs leading-tight">
                    <div class="font-semibold">ณัฐชา ใจดี</div>
                    <div class="text-white/70 text-[10px]">พนักงานสต็อก</div>
                </div>
            </div>
        </div>
    </div>
</header>