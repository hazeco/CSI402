@model Khetsophon_CSI402_8456.ViewModels.LoginViewModel;
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "_AccountLayout";
}

<div class="min-h-dvh flex-1 flex items-center justify-center px-4 py-8 sm:py-12 bg-white">
    <div class="w-full max-w-sm">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8">
            <div class="flex flex-col items-center text-center mb-6">
                <div class="w-14 h-14 rounded-2xl bg-secondary/30 flex items-center justify-center mb-3">
                    <svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                </div>
                <h1 class="text-xl font-bold text-slate">เข้าสู่ระบบ</h1>
                <p class="text-sm text-slate-500 mt-1">เข้าสู่ระบบเพื่อสั่งพรีออเดอร์และสะสมแต้ม</p>
            </div>

            @* Form Parameters expected by Controller:
               [Email: string, Password: string]
            *@
            <form class="space-y-4" asp-controller="Account" asp-action="Login">
              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1.5">อีเมล</label>
                <div class="relative" >
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"></path></svg>
                  <input asp-for="Email" type="email" placeholder="you@example.com" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                </div>
              </div>
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="block text-xs font-medium text-slate-700">รหัสผ่าน</label>
                </div>
                <div class="relative">
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                  <input asp-for="Password" type="password" placeholder="••••••••" class="w-full pl-9 pr-9 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                  <svg class="cursor-pointer w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <label class="flex items-center gap-2 text-xs text-slate-500">
                  <input type="checkbox" class="cursor-pointer rounded border-slate-300 text-primary focus:ring-primary/30">
                  <div class="font-medium text-slate-600">จดจำฉันไว้ในเครื่องนี้</div>
                </label>
                <a asp-controller="Account" asp-action="ResetPassword" class="text-xs text-primary hover:underline">ลืมรหัสผ่าน?</a>
              </div>
              <button type="submit"
                 class="block w-full py-2.5 rounded-xl bg-primary text-white text-center text-sm font-semibold shadow-sm hover:opacity-90 transition cursor-pointer">
                  เข้าสู่ระบบ
              </button>

              <!-- Mock Fast Login for Demo -->
              <div class="pt-2 border-t border-slate-100 space-y-2">
                  <span class="block text-[11px] font-bold text-slate-400 text-center uppercase tracking-wider">เข้าสู่ระบบด่วน (Mock Fast Login)</span>
                  <div class="grid grid-cols-2 gap-2">
                      <a asp-controller="Home" asp-action="Customer"
                         class="col-span-2 flex items-center justify-center gap-2 rounded-xl bg-secondary/25 py-2 px-3 text-xs font-bold text-primary hover:bg-secondary/40 transition-colors cursor-pointer">
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                              <circle cx="12" cy="7" r="4"></circle>
                          </svg>
                          <span>ลูกค้าทั่วไป (Customer View)</span>
                      </a>
                      <a asp-controller="Staff" asp-action="Index"
                         class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white py-2 px-2 text-xs font-bold text-text hover:bg-slate-50 transition-colors cursor-pointer">
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                          </svg>
                          <span>พนักงาน (Staff)</span>
                      </a>
                      <a asp-controller="Owner" asp-action="Promotions"
                         class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white py-2 px-2 text-xs font-bold text-text hover:bg-slate-50 transition-colors cursor-pointer">
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                          </svg>
                          <span>เจ้าของร้าน (Owner)</span>
                      </a>
                      <a asp-controller="ITSupport" asp-action="Dashboard"
                         class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white py-2 px-2 text-xs font-bold text-text hover:bg-slate-50 transition-colors cursor-pointer">
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <rect x="3" y="3" width="7" height="7"></rect>
                              <rect x="14" y="3" width="7" height="7"></rect>
                              <rect x="14" y="14" width="7" height="7"></rect>
                              <rect x="3" y="14" width="7" height="7"></rect>
                          </svg>
                          <span>ไอที (IT Support)</span>
                      </a>
                      <a asp-controller="Accountant" asp-action="Index"
                         class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white py-2 px-2 text-xs font-bold text-text hover:bg-slate-50 transition-colors cursor-pointer">
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <line x1="12" y1="1" x2="12" y2="23"></line>
                              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                          </svg>
                          <span>คนทำบัญชี (Account)</span>
                      </a>
                  </div>
              </div>

              <div class="flex items-center gap-3 my-4">
                  <div class="h-px flex-1 bg-slate-200"></div>
                  <span class="text-[11px] text-slate-400">หรือ</span>
                  <div class="h-px flex-1 bg-slate-200"></div>
              </div>

              <p class="text-center text-xs text-slate-500">
                ยังไม่มีบัญชีสมาชิก?
                <a asp-controller="Account" asp-action="Register" class="text-primary font-bold hover:underline">สมัครสมาชิกใหม่</a>
              </p>
            </form>
        </div>
    <div>
        @ViewBag.Email
        @ViewBag.Phone
        @ViewBag.Password
    </div>
    </div>
</div>