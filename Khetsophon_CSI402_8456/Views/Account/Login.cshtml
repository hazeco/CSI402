@{
    ViewData["Title"] = "AccountIndex";
    Layout = "_AccountLayout";
}

<div class="flex-1 flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-sm">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8">
            <div class="flex flex-col items-center text-center mb-6">
                <div class="w-14 h-14 rounded-2xl bg-secondary/30 flex items-center justify-center mb-3">
                    <svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                </div>
                <h1 class="text-xl font-bold text-slate">เข้าสู่ระบบ</h1>
                <p class="text-sm text-slate-500 mt-1">เข้าสู่ระบบเพื่อสั่งพรีออเดอร์และสะสมแต้ม</p>
            </div>

            <form class="space-y-4">
              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1.5">อีเมล</label>
                <div class="relative" >
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"></path></svg>
                  <input type="email" placeholder="you@example.com" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                </div>
              </div>
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="block text-xs font-medium text-slate-700">รหัสผ่าน</label>
                </div>
                <div class="relative">
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                  <input type="password" placeholder="••••••••" class="w-full pl-9 pr-9 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                  <svg class="cursor-pointer w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <label class="flex items-center gap-2 text-xs text-slate-500">
                  <input type="checkbox" class="cursor-pointer rounded border-slate-300 text-primary focus:ring-primary/30">
                  <div class="font-medium text-slate-600">จดจำฉันไว้ในเครื่องนี้</div>
                </label>
                <a href="#" class="text-xs text-primary hover:underline">ลืมรหัสผ่าน?</a>
              </div>
              <button type="button" class="cursor-pointer w-full py-2.5 rounded-xl bg-primary text-white text-sm font-semibold shadow-sm hover:opacity-90 transition">เข้าสู่ระบบ</button>
            <div class="flex items-center gap-3 my-5">
                <div class="h-px flex-1 bg-slate-300/10"></div>
                <span class="text-[11px] text-slate-500">หรือ</span>
                <div class="h-px flex-1 bg-slate-300/10"></div>
            </div>
            <p class="text-center text-[14px] text-slate-500">
              หากยังไม่มีบัญชี?
              <a asp-area="" asp-controller="Account" asp-action="Register" class="text-primary font-semibold hover:underline">สมัครสมาชิก</a>
            </p>
            </form>
        </div>
    </div>
</div>