@{
    ViewData["Title"] = "เปลี่ยนรหัสผ่าน";
    Layout = "_AccountLayout";
}

<div class="h-dvh flex-1 flex items-center justify-center px-4 py-10 bg-white">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-7 sm:p-8">
            <div class="flex flex-col items-center text-center mb-6">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0110 0v4"></path>
                    </svg>
                </div>
                <h1 class="text-xl font-bold text-slate">เปลี่ยนรหัสผ่าน</h1>
                <p class="text-sm text-slate-500 mt-1">กรอกข้อมูลให้ถูกต้องเพื่อเปลี่ยนรหัสผ่าน</p>
            </div>

            <form class="space-y-4" asp-controller="Account" asp-action="ResetPassword">
                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1.5">รหัสผ่านปัจจุบัน</label>
                    <div class="relative">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0110 0v4"></path>
                        </svg>
                        <input type="password" placeholder="••••••••" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1.5">รหัสผ่านใหม่</label>
                    <div class="relative">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0110 0v4"></path>
                        </svg>
                        <input type="password" placeholder="อย่างน้อย 8 ตัวอักษร" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1.5">ยืนยันรหัสผ่านใหม่</label>
                    <div class="relative">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0110 0v4"></path>
                        </svg>
                        <input type="password" placeholder="พิมพ์รหัสผ่านใหม่อีกครั้ง" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                    </div>
                </div>

                <div class="bg-slate-50/80 rounded-xl p-3.5 space-y-1 border border-slate-100">
                    <div class="text-xs text-slate-500">• ความยาวอย่างน้อย 8 ตัวอักษร</div>
                    <div class="text-xs text-slate-500">• ควรมีตัวอักษรและตัวเลขผสมกัน</div>
                    <div class="text-xs text-slate-500">• ไม่ควรซ้ำกับรหัสผ่านเดิม</div>
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <a asp-controller="Account" asp-action="Login" class="cursor-pointer flex-1 py-2.5 text-center rounded-xl border border-slate-300 bg-white text-slate-700 text-sm font-semibold hover:bg-slate-50 transition">ยกเลิก</a>
                    <button type="button" class="cursor-pointer flex-1 py-2.5 rounded-xl bg-primary text-white text-sm font-semibold shadow-sm hover:opacity-90 transition">บันทึกรหัสผ่านใหม่</button>
                </div>
            </form>
        </div>
    </div>
</div>
