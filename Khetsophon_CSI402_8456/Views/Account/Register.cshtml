@{
    ViewData["Title"] = "สมัครสมาชิก";
    Layout = "_AccountLayout";
}

<div class="h-dvh flex-1 flex items-center justify-center px-4 py-8 bg-white">
        <div class="w-full max-w-sm">
          <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8">
            <div class="flex flex-col items-center text-center mb-6">
              <div class="w-14 h-14 rounded-2xl bg-secondary/30 flex items-center justify-center mb-3">
                <svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="17" y1="11" x2="23" y2="11"></line></svg>
              </div>
              <h1 class="text-xl font-bold text-slate">สมัครสมาชิก</h1>
              <p class="text-sm text-slate-500 mt-1">สมัครเพื่อพรีออเดอร์และสะสมแต้ม</p>
            </div>

            <form class="space-y-3.5" asp-controller="Account" asp-action="Register">
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1.5">อีเมล</label>
                <div class="relative">
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"></path></svg>
                  <input type="email" placeholder="you@example.com" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1.5">เบอร์โทรศัพท์</label>
                <div class="relative">
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.339 1.85.573 2.81.7A2 2 0 0122 16.92z"></path></svg>
                  <input type="tel" placeholder="08X-XXX-XXXX" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1.5">รหัสผ่าน</label>
                <div class="relative">
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                  <input type="password" placeholder="อย่างน้อย 8 ตัวอักษร" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1.5">ยืนยันรหัสผ่าน</label>
                <div class="relative">
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                  <input type="password" placeholder="พิมพ์รหัสผ่านอีกครั้ง" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                </div>
              </div>
              <button type="button" class="w-full py-2.5 rounded-xl bg-primary text-white text-sm font-semibold shadow-sm hover:opacity-90 transition mt-1">สมัครสมาชิก</button>
              <div class="flex items-center gap-3 my-5">
                <div class="h-px flex-1 bg-slate-300/10"></div>
                <span class="text-[11px] text-slate-500">หรือ</span>
                <div class="h-px flex-1 bg-slate-300/10"></div>
                </div>
            </form>

            <p class="text-center text-[14px] text-slate-500 mt-5">
              มีบัญชีอยู่แล้ว?
              <a asp-area="" asp-controller="Account" asp-action="Login" class="text-primary font-semibold hover:underline">เข้าสู่ระบบ</a>
            </p>
          </div>
          <p class="text-center text-[11px] text-slate-500 mt-5 leading-relaxed">
            บัญชีสมาชิกใช้สำหรับพรีออเดอร์และสะสมแต้มเท่านั้น<br>
            การชำระเงินและรับสินค้าทำที่หน้าร้านเสมอ
          </p>
        </div>
      </div>