@{
    ViewData["Title"] = "สต็อกสินค้า";
    Layout = "_StaffLayout";
}

<div class="min-h-[600px] bg-paper flex flex-col">
<div>
    @ViewBag.ReservationNumber
</div>
    <!-- MAIN -->
    <main class="flex-1 px-6 py-6 space-y-5">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-xl font-bold text-slate">สต็อกสินค้า</h1>
                <p class="text-sm text-slate/55 mt-0.5">ภาพรวมคงเหลือทั้งหมดในร้าน อัปเดตอัตโนมัติทุกครั้งที่รับเข้า/ขายออก</p>
            </div>
            <a asp-controller="Staff" asp-action="ScanReceive" class="shrink-0 flex items-center gap-2 bg-accent hover:bg-accent/90 text-white font-semibold px-5 py-2.5 rounded-xl shadow-sm shadow-accent/30 text-sm">
                <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/><path d="M3 12h18"/></svg>
                สแกนรับสินค้า
            </a>
        </div>

        <!-- ALERT BANNER -->
        <div class="rounded-2xl border border-red-200 bg-red-50 overflow-hidden">
            <div class="flex items-center gap-2 px-4 py-2.5 bg-red-100/70 border-b border-red-200">
                <svg class="w-4.5 h-4.5 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                <span class="text-sm font-bold text-red-700">แจ้งเตือนสต็อก — มีสินค้าใกล้หมด/หมดสต็อก 3 รายการ ต้องดำเนินการ</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-3">
                <div class="flex items-center justify-between bg-white rounded-xl border border-red-100 px-3.5 py-2.5">
                    <div>
                        <div class="text-sm font-semibold text-slate">ตุ๊กตาหมี Baba (สีชมพู)</div>
                        <div class="text-[11px] text-slate/45 font-mono">SKU-BB-1042</div>
                    </div>
                    <span class="text-[11px] font-bold bg-red-100 text-red-700 px-2.5 py-1 rounded-full shrink-0">หมด · 0 ชิ้น</span>
                </div>
                <div class="flex items-center justify-between bg-white rounded-xl border border-amber-100 px-3.5 py-2.5">
                    <div>
                        <div class="text-sm font-semibold text-slate">กล่องสุ่ม Mystery Box S2</div>
                        <div class="text-[11px] text-slate/45 font-mono">SKU-MB-2201</div>
                    </div>
                    <span class="text-[11px] font-bold bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full shrink-0">ใกล้หมด · 2 ชิ้น</span>
                </div>
                <div class="flex items-center justify-between bg-white rounded-xl border border-amber-100 px-3.5 py-2.5">
                    <div>
                        <div class="text-sm font-semibold text-slate">พวงกุญแจแมวส้ม</div>
                        <div class="text-[11px] text-slate/45 font-mono">SKU-KC-0087</div>
                    </div>
                    <span class="text-[11px] font-bold bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full shrink-0">ใกล้หมด · 3 ชิ้น</span>
                </div>
            </div>
        </div>

        <!-- SEARCH / FILTER BAR -->
        <div class="flex flex-wrap items-center gap-2.5 bg-white rounded-2xl border border-black/5 shadow-sm px-4 py-3">
            <div class="relative flex-1 min-w-[220px]">
                <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input type="text" placeholder="ค้นหาชื่อสินค้าหรือ SKU..." class="w-full pl-9 pr-3 py-2 rounded-xl border border-black/10 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
            </div>
            <select class="text-sm border border-black/10 rounded-xl px-3 py-2 text-slate/70 bg-white">
                <option>ทุกหมวดหมู่</option>
                <option>ตุ๊กตา &amp; ของสะสม</option>
                <option>เครื่องเขียน</option>
                <option>เสื้อผ้า/แอคเซสซอรี่</option>
            </select>
            <div class="flex items-center gap-1.5 text-xs font-medium">
                <button class="px-3 py-2 rounded-xl bg-primary text-white">ทั้งหมด 32</button>
                <button class="px-3 py-2 rounded-xl bg-black/5 text-slate/60 hover:bg-black/10">ปกติ 27</button>
                <button class="px-3 py-2 rounded-xl bg-amber-100 text-amber-700 hover:bg-amber-200">ใกล้หมด 4</button>
                <button class="px-3 py-2 rounded-xl bg-red-100 text-red-700 hover:bg-red-200">หมด 1</button>
            </div>
        </div>

        <!-- STOCK TABLE -->
        <div class="bg-white rounded-2xl border border-black/5 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-slate/[0.03] text-slate/50 text-xs uppercase tracking-wide">
                            <th class="text-left font-semibold px-4 py-3">สินค้า</th>
                            <th class="text-left font-semibold px-4 py-3">SKU</th>
                            <th class="text-center font-semibold px-4 py-3">คงเหลือ</th>
                            <th class="text-center font-semibold px-4 py-3">สถานะ</th>
                            <th class="text-left font-semibold px-4 py-3">รับเข้าล่าสุด</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5">
                        @foreach (var item in new[] {
                            new { Icon = "🧸", Name = "ตุ๊กตาหมี Baba (สีชมพู)", Sku = "SKU-BB-1042", Stock = 0, Status = "หมด", Date = "28 ส.ค. 2569" },
                            new { Icon = "📦", Name = "กล่องสุ่ม Mystery Box S2", Sku = "SKU-MB-2201", Stock = 2, Status = "ใกล้หมด", Date = "2 ก.ย. 2569" },
                            new { Icon = "🔑", Name = "พวงกุญแจแมวส้ม", Sku = "SKU-KC-0087", Stock = 3, Status = "ใกล้หมด", Date = "30 ส.ค. 2569" },
                            new { Icon = "🃏", Name = "การ์ดสะสมชุด Sakura Vol.4", Sku = "SKU-CD-3390", Stock = 48, Status = "ปกติ", Date = "5 ก.ย. 2569" },
                            new { Icon = "📓", Name = "สมุดโน้ตลายดอกไม้ A5", Sku = "SKU-NB-0512", Stock = 64, Status = "ปกติ", Date = "4 ก.ย. 2569" },
                            new { Icon = "👕", Name = "เสื้อยืดลาย FriendHouse Classic", Sku = "SKU-TS-7710", Stock = 21, Status = "ปกติ", Date = "1 ก.ย. 2569" },
                            new { Icon = "🥤", Name = "แก้วน้ำลาย Bunny Cafe", Sku = "SKU-CP-4456", Stock = 15, Status = "ปกติ", Date = "29 ส.ค. 2569" },
                            new { Icon = "✉️", Name = "โปสการ์ดชุดเมืองไทย 6 ใบ", Sku = "SKU-PC-0921", Stock = 37, Status = "ปกติ", Date = "27 ส.ค. 2569" },
                            new { Icon = "🐱", Name = "ตุ๊กตาแมวส้ม ไซส์ M", Sku = "SKU-CT-1875", Stock = 12, Status = "ปกติ", Date = "22 ส.ค. 2569" }
                        })
                        {
                            var isOutOfStock = item.Status == "หมด";
                            var isLowStock = item.Status == "ใกล้หมด";
                            <tr class="hover:bg-secondary/10">
                                <td class="px-4 py-3 font-medium text-slate flex items-center gap-2.5"><span class="w-8 h-8 rounded-lg bg-secondary/30 flex items-center justify-center text-sm">@item.Icon</span>@item.Name</td>
                                <td class="px-4 py-3 font-mono text-xs text-slate/50">@item.Sku</td>
                                <td class="px-4 py-3 text-center font-bold @(isOutOfStock ? "text-red-600" : isLowStock ? "text-amber-600" : "text-slate")">@item.Stock</td>
                                <td class="px-4 py-3 text-center"><span class="text-[11px] font-bold @(isOutOfStock ? "bg-red-100 text-red-700" : isLowStock ? "bg-amber-100 text-amber-700" : "bg-green-100 text-green-700") px-2.5 py-1 rounded-full">@item.Status</span></td>
                                <td class="px-4 py-3 text-slate/50">@item.Date</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex items-center justify-between px-4 py-3 border-t border-black/5 text-xs text-slate/45">
                <span>แสดง 9 จาก 32 รายการ</span>
                <div class="flex items-center gap-1">
                    <button class="px-2.5 py-1.5 rounded-lg border border-black/10">ก่อนหน้า</button>
                    <button class="px-2.5 py-1.5 rounded-lg bg-primary text-white">1</button>
                    <button class="px-2.5 py-1.5 rounded-lg border border-black/10">2</button>
                    <button class="px-2.5 py-1.5 rounded-lg border border-black/10">3</button>
                    <button class="px-2.5 py-1.5 rounded-lg border border-black/10">ถัดไป</button>
                </div>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="shrink-0 px-6 py-3 border-t border-black/5 bg-white flex items-center justify-between text-[11px] text-slate/40">
        <span>FriendHouse Staff Console · เข้าสู่ระบบเป็น ณัฐชา ใจดี (พนักงานสต็อก) · กะ 09:00–18:00</span>
        <span>อัปเดตล่าสุด 09 ก.ย. 2569 · 14:22 น.</span>
    </footer>

</div>
