@model Khetsophon_CSI402_8456.ViewModels.CounterPreorderViewModel;
@{
    ViewData["Title"] = "เคาน์เตอร์พรีออเดอร์";
    Layout = "_StaffLayout";
}

<main class="flex-1 px-6 py-6 flex flex-col items-center">
        <div class="w-full max-w-2xl space-y-5">

          <div class="text-center">
            <h1 class="text-xl font-bold text-slate">เคาน์เตอร์พรีออเดอร์</h1>
            <p class="text-sm text-slate/55 mt-0.5">ค้นหาลูกค้าเพื่อเช็คสถานะรับสินค้าที่จองไว้</p>
          </div>

          <!-- BIG SEARCH BAR -->
          <form asp-controller="Staff" asp-action="CounterPreorder">
            <div class="bg-white rounded-2xl border border-black/5 shadow-md p-4">
            <label class="text-xs font-bold text-slate/50 mb-2 block">ค้นหาด้วยเบอร์โทรสมาชิก หรือหมายเลขการจอง</label>
            <div class="flex items-center gap-2.5">
              <div class="relative flex-1">
                <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-primary/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.68 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0122 16.92z"></path></svg>
                <input asp-for="ReservationNumber" type="text" value="081-234-5000" placeholder="กรอกเบอร์โทรหรือหมายเลขการจอง" class="w-full pl-12 pr-4 py-4 rounded-xl border-2 border-primary/20 text-lg font-semibold tracking-wide focus:outline-none focus:ring-4 focus:ring-primary/15 focus:border-primary">
              </div>
              <button type="submit" class="shrink-0 flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-bold px-6 py-4 rounded-xl text-base shadow-sm">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
                ค้นหา
              </button>
            </div>
            <p class="text-[11px] text-slate/35 mt-2">พิมพ์เบอร์โทรของสมาชิกที่ใช้ตอนสั่งพรีออเดอร์ หรือหมายเลขการจอง ระบบจะแสดงรายการที่ยังไม่มารับ</p>
          </div>
          </form>

          <!-- FOUND RESULT CARD -->
          <div class="bg-white rounded-2xl border-2 border-secondary shadow-lg overflow-hidden">
            <div class="flex items-center justify-between px-5 py-3 bg-secondary/25 border-b border-secondary/60">
              <span class="flex items-center gap-2 text-sm font-bold text-primary">
                <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
                พบรายการพรีออเดอร์ 1 รายการ
              </span>
              <span class="text-[11px] font-bold bg-accent/15 text-text px-3 py-1 rounded-full">รอรับที่ร้าน</span>
            </div>

            <div class="p-5 space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-16 h-16 rounded-xl bg-secondary/25 flex items-center justify-center text-3xl shrink-0">🧸</div>
                <div class="flex-1 min-w-0">
                  <div class="text-lg font-bold text-slate leading-snug">ตุ๊กตาหมี Baba รุ่นลิมิเต็ด (สีชมพู)</div>
                  <div class="text-sm text-slate/50 mt-0.5">จำนวนที่จอง: 1 ชิ้น · มัดจำแล้ว 100 บาท</div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="bg-slate/[0.03] rounded-xl px-4 py-3">
                  <div class="text-[11px] font-semibold text-slate/40 mb-1">หมายเลขการจอง / เบอร์โทร</div>
                  <div class="text-sm font-bold text-slate">DB0123456 · 081-234-5xxx</div>
                </div>
                <div class="bg-slate/[0.03] rounded-xl px-4 py-3">
                  <div class="text-[11px] font-semibold text-slate/40 mb-1">แต้มสะสมปัจจุบัน</div>
                  <div class="text-sm font-bold text-slate">180 แต้ม</div>
                </div>
                <div class="bg-slate/[0.03] rounded-xl px-4 py-3">
                  <div class="text-[11px] font-semibold text-slate/40 mb-1">วันที่สั่งจอง</div>
                  <div class="text-sm font-bold text-slate">28 ส.ค. 2569</div>
                </div>
                <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3">
                  <div class="text-[11px] font-semibold text-amber-700/70 mb-1">กำหนดมารับภายใน</div>
                  <div class="text-sm font-bold text-amber-700">09 ก.ย. 2569 · ก่อน 20:00 น.</div>
                </div>
              </div>

              <!-- BIG ACTION BUTTONS -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                <button class="flex items-center justify-center gap-2.5 bg-green-600 hover:bg-green-700 text-white font-bold text-base py-5 rounded-2xl shadow-md shadow-green-600/25">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
                  มารับแล้ว / ชำระเงินแล้ว
                </button>
                <button class="flex items-center justify-center gap-2.5 bg-white border-2 border-red-400 text-red-500 hover:bg-red-50 font-bold text-base py-5 rounded-2xl">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18"></path><path d="M6 6l12 12"></path></svg>
                  ไม่มารับ
                </button>
              </div>
              <p class="text-[11px] text-slate/40 text-center flex items-center justify-center gap-1.5">
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                เมื่อกด "มารับแล้ว" ระบบจะให้กรอกเบอร์โทรสมาชิกอีกครั้งเพื่อสะสมแต้ม และสถานะพรีออเดอร์ของลูกค้าจะถูกปิดโดยอัตโนมัติ
              </p>
            </div>
          </div>

          <!-- RECENT SEARCHES -->
          <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-4">
            <div class="text-xs font-bold text-slate/40 mb-2">ค้นหาล่าสุดในกะนี้</div>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs font-mono bg-slate/[0.04] text-slate/60 px-3 py-1.5 rounded-full">089-xxx-1120 · รับแล้ว</span>
              <span class="text-xs font-mono bg-slate/[0.04] text-slate/60 px-3 py-1.5 rounded-full">062-xxx-8843 · รับแล้ว</span>
              <span class="text-xs font-mono bg-red-50 text-red-500 px-3 py-1.5 rounded-full">095-xxx-2091 · ไม่มารับ</span>
            </div>
          </div>
        </div>
      </main>