@{
    ViewData["Title"] = "สแกนรับสินค้าเข้าสต็อก";
    Layout = "_StaffLayout";

    // Top-of-file Media & Content Configuration
    var pageHeader = new {
        Title = "สแกนรับสินค้าเข้าสต็อก",
        Subtitle = "สแกน QR/บาร์โค้ดบนกล่องสินค้า ระบบจะบวกจำนวนเข้าสต็อกให้อัตโนมัติ",
        MockBadge = "MOCK — ยังไม่เชื่อมกับสแกนเนอร์จริง"
    };

    var recentScans = new[] {
        new { Time = "14:31:02", Name = "การ์ดสะสมชุด Sakura Vol.4", Sku = "SKU-CD-3390", Qty = "+24" },
        new { Time = "14:28:47", Name = "สมุดโน้ตลายดอกไม้ A5", Sku = "SKU-NB-0512", Qty = "+20" },
        new { Time = "14:26:15", Name = "พวงกุญแจแมวส้ม", Sku = "SKU-KC-0087", Qty = "+5" },
        new { Time = "14:22:58", Name = "แก้วน้ำลาย Bunny Cafe", Sku = "SKU-CP-4456", Qty = "+12" }
    };
}

<div class="space-y-6">
    <!-- Title & Status Badge (Matching Figma frame_9_4.png) -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
            <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
        </div>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold bg-[#FEF3C7] text-[#B45309] border border-[#FDE68A] px-3.5 py-1.5 rounded-full shadow-2xs">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>@pageHeader.MockBadge</span>
        </span>
    </div>

    <!-- 2 Columns Scanner & Manual Input (Matching Figma frame_9_4.png) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- CAMERA / MOCK SCAN (Left Card) -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 flex flex-col justify-between">
            <div>
                <h2 class="text-sm font-bold text-[#050315] flex items-center gap-2">
                    <svg class="size-4 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    <span>สแกนด้วยกล้อง</span>
                </h2>
                <p class="text-xs text-gray-400 mt-1 mb-4">วางกล่องสินค้าให้โค้ดอยู่ในกรอบ ระบบจะอ่านรหัสให้อัตโนมัติ</p>

                <!-- Camera Mock Frame with dashed cyan border -->
                <div class="relative w-full h-56 rounded-xl border-2 border-dashed border-[#92EEFF] bg-[#92EEFF]/10 flex flex-col items-center justify-center p-6 text-center">
                    <div class="size-11 rounded-lg bg-gray-800 text-white flex items-center justify-center mb-3 shadow-xs">
                        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                    </div>
                    <span class="text-sm font-bold text-[#050315]">จำลองกล้องสแกน QR/บาร์โค้ด</span>
                    <span class="text-xs text-gray-400 mt-1">วางกล่องสินค้าให้โค้ดอยู่ในกรอบ ระบบจะอ่านรหัสให้อัตโนมัติ</span>
                </div>
            </div>

            <div class="mt-5">
                <button type="button" onclick="simulateScan()" class="w-full bg-[#3027FF] hover:bg-[#251CD9] text-white font-bold py-3 rounded-xl text-sm flex items-center justify-center gap-2 shadow-xs transition-colors cursor-pointer">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    <span>จำลองการสแกน</span>
                </button>
                <p class="text-[11px] text-gray-400 text-center mt-2">กดปุ่มเพื่อจำลองผลลัพธ์การสแกน 1 รายการ (ไม่ใช้กล้องจริง)</p>
            </div>
        </div>

        <!-- MANUAL INPUT (Right Card) -->
        @* Form Parameters expected by Controller:
           [Sku: string, Quantity: int]
        *@
        <form asp-controller="Staff" asp-action="ScanReceive" class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 flex flex-col justify-between">
            <div>
                <h2 class="text-sm font-bold text-[#050315] flex items-center gap-2">
                    <svg class="size-4 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
                    </svg>
                    <span>กรอกรับเข้าด้วยตนเอง</span>
                </h2>
                <p class="text-xs text-gray-400 mt-1 mb-4">ใช้เมื่อสแกนไม่ได้ หรือบาร์โค้ดชำรุด</p>

                <div class="space-y-4">
                    <!-- SKU Field -->
                    <div>
                        <label class="text-xs font-semibold text-gray-700 block mb-1.5">รหัสสินค้า (SKU)</label>
                        <div class="relative">
                            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 font-mono tracking-tighter text-xs">|||||</span>
                            <input type="text" name="Sku" id="scanSkuInput" placeholder="เช่น SKU-BB-1042"
                                   class="w-full bg-white border border-gray-200 rounded-xl pl-12 pr-4 py-2.5 text-sm font-mono text-[#050315] placeholder:text-gray-400 focus:outline-none focus:border-[#2F39A9] focus:ring-1 focus:ring-[#2F39A9] shadow-2xs" />
                        </div>
                    </div>

                    <!-- Quantity Stepper -->
                    <div>
                        <label class="text-xs font-semibold text-gray-700 block mb-1.5">จำนวนที่รับเข้า</label>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="adjustQty(-1)" class="size-10 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-bold flex items-center justify-center cursor-pointer shadow-2xs">
                                −
                            </button>
                            <input type="number" name="Quantity" id="scanQtyInput" value="12" min="1"
                                   class="flex-1 text-center py-2 border border-gray-200 rounded-xl font-bold text-base text-[#050315] focus:outline-none focus:border-[#2F39A9]" />
                            <button type="button" onclick="adjustQty(1)" class="size-10 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-bold flex items-center justify-center cursor-pointer shadow-2xs">
                                +
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <button type="submit" class="w-full bg-[#2F39A9] hover:bg-[#242D87] text-white font-bold py-3 rounded-xl text-sm shadow-xs transition-colors cursor-pointer">
                    ยืนยันรับเข้าสต็อก
                </button>
                <p class="text-[11px] text-gray-400 text-center mt-2">ยอดคงเหลือของสินค้าจะถูกอัปเดตทันทีหลังยืนยัน</p>
            </div>
        </form>
    </div>

    <!-- Bottom Scanned History Table (Exact frame_9_4.png) -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2 text-sm font-bold text-[#050315]">
                <svg class="size-4.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>รายการที่สแกนรับเข้าในรอบนี้</span>
            </div>
            <span class="text-xs text-gray-500 font-medium">4 รายการ · รวม 61 ชิ้น</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[540px]">
                <thead>
                    <tr class="text-left text-xs font-semibold text-gray-400 border-b border-gray-100 bg-[#FBFBFE]">
                        <th class="py-3 px-6">เวลา</th>
                        <th class="py-3 px-6">สินค้า</th>
                        <th class="py-3 px-6">SKU</th>
                        <th class="py-3 px-6 text-center">จำนวนที่รับ</th>
                        <th class="py-3 px-6 text-center">สถานะ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var s in recentScans)
                    {
                        <tr class="hover:bg-gray-50/70 transition-colors">
                            <td class="py-3.5 px-6 text-gray-500 font-mono text-xs">@s.Time</td>
                            <td class="py-3.5 px-6 font-semibold text-[#050315]">@s.Name</td>
                            <td class="py-3.5 px-6 text-gray-500 font-mono text-xs">@s.Sku</td>
                            <td class="py-3.5 px-6 text-center font-bold text-[#16A34A]">@s.Qty</td>
                            <td class="py-3.5 px-6 text-center">
                                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#DCFCE7] text-[#16A34A]">
                                    สำเร็จ
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Staff Console Footer (frame_9_4.png) -->
    <div class="pt-6 border-t border-gray-200/60 flex items-center justify-between flex-wrap gap-2 text-xs text-gray-400">
        <div>
            FriendHouse Staff Console · เข้าสู่ระบบเป็น ณัฐชา ใจดี (พนักงานสต็อก) · กะ 09:00–18:00
        </div>
        <div>
            โหมดจำลอง (MOCK) · ไม่มีการเชื่อมต่อฮาร์ดแวร์สแกนเนอร์
        </div>
    </div>
</div>

<!-- Modal: Scan Success (Figma [65:3115]) -->
<div id="scanSuccessModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center shadow-xl space-y-4 animate-scale-up">
        <div class="size-14 rounded-full bg-[#DCFCE7] text-[#16A34A] mx-auto flex items-center justify-center">
            <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>
        <div>
            <h3 class="text-lg font-bold text-[#050315]">รับเข้าสต็อกสำเร็จ</h3>
            <p class="text-sm font-semibold text-gray-700 mt-1">กล่องสุ่ม Mystery Box S2</p>
            <p class="text-xs font-mono text-gray-400">SKU: SKU-MB-2201</p>
            <p class="text-xs text-gray-500 mt-2">สินค้า 24 ชิ้นถูกเพิ่มเข้าคลังแล้ว</p>
        </div>
        <button type="button" onclick="closeSuccessModal()" class="w-full bg-[#2F39A9] hover:bg-[#242D87] text-white py-2.5 rounded-xl font-bold text-sm shadow-xs cursor-pointer">
            สำเร็จ
        </button>
    </div>
</div>

@section Scripts {
    <script>
        function adjustQty(delta) {
            const input = document.getElementById('scanQtyInput');
            if (input) {
                let val = parseInt(input.value) || 1;
                val = Math.max(1, val + delta);
                input.value = val;
            }
        }

        function simulateScan() {
            document.getElementById('scanSuccessModal')?.classList.remove('hidden');
        }

        function closeSuccessModal() {
            document.getElementById('scanSuccessModal')?.classList.add('hidden');
        }
    </script>
}
