@{
    ViewData["Title"] = "สแกนรับสินค้า";
    Layout = "_StaffLayout";
}

<div class="min-h-[600px] bg-paper flex flex-col">

    <!-- HEADER -->

    <!-- MAIN -->
    <main class="flex-1 px-6 py-6 space-y-5">
        <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
                <h1 class="text-xl font-bold text-slate">สแกนรับสินค้าเข้าสต็อก</h1>
                <p class="text-sm text-slate/55 mt-0.5">สแกน QR/บาร์โค้ดบนกล่องสินค้า ระบบจะบวกจำนวนเข้าสต็อกให้อัตโนมัติ</p>
            </div>
            <span class="flex items-center gap-1.5 text-[11px] font-bold bg-amber-100 text-amber-700 border border-amber-300 px-3 py-1.5 rounded-full">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                MOCK — ยังไม่เชื่อมกับสแกนเนอร์จริง
            </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

            <!-- CAMERA / MOCK SCAN -->
            <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-5 flex flex-col">
                <h2 class="text-sm font-bold text-slate mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="15" height="12" rx="2"/><path d="M17 10l5-3v10l-5-3"/></svg>
                    สแกนด้วยกล้อง
                </h2>
                <div class="relative flex-1 min-h-[260px] rounded-xl border-2 border-dashed border-primary/30 bg-primary/[0.04] flex flex-col items-center justify-center gap-3 overflow-hidden">
                    <div class="absolute inset-6 rounded-lg border-2 border-secondary/70"></div>
                    <div class="absolute left-6 right-6 top-1/2 h-0.5 bg-accent/70"></div>
                    <svg class="w-12 h-12 text-primary/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    <p class="text-sm font-semibold text-primary/70 text-center px-6">จำลองกล้องสแกน QR/บาร์โค้ด</p>
                    <p class="text-xs text-slate/40 text-center px-8">วางกล่องสินค้าให้โค้ดอยู่ในกรอบ ระบบจะอ่านรหัสให้อัตโนมัติ</p>
                </div>
                @* Mock scan trigger — wire up to StockController.ScanReceive via JS/fetch or a hidden form in the real client-side implementation *@
                <button type="button" class="mt-4 w-full flex items-center justify-center gap-2 bg-accent hover:bg-accent/90 text-white font-bold px-5 py-3.5 rounded-xl shadow-sm shadow-accent/30 text-sm">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    จำลองการสแกน
                </button>
                <p class="text-[11px] text-slate/35 text-center mt-2">กดปุ่มเพื่อจำลองผลลัพธ์การสแกน 1 รายการ (ไม่ใช้กล้องจริง)</p>
            </div>

            <!-- MANUAL FALLBACK FORM -->
            @* TODO: replace the plain name= inputs below with a strongly-typed ScanReceiveViewModel (Sku, Quantity) and asp-for bindings *@
            <form asp-controller="Stock" asp-action="ScanReceive" method="post" class="bg-white rounded-2xl border border-black/5 shadow-sm p-5 flex flex-col">
                <h2 class="text-sm font-bold text-slate mb-1 flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/></svg>
                    กรอกรับเข้าด้วยตนเอง
                </h2>
                <p class="text-xs text-slate/45 mb-4">ใช้เมื่อสแกนไม่ได้ หรือบาร์โค้ดชำรุด</p>

                <label class="text-xs font-semibold text-slate/60 mb-1.5 block">รหัสสินค้า (SKU)</label>
                <div class="relative mb-4">
                    <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5v14M8 5v14M12 5v14M17 5v14M21 5v14"/></svg>
                    <input type="text" name="Sku" placeholder="เช่น SKU-BB-1042" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-black/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                </div>

                <label class="text-xs font-semibold text-slate/60 mb-1.5 block">จำนวนที่รับเข้า</label>
                <div class="flex items-center gap-2 mb-5">
                    <button type="button" class="w-11 h-11 shrink-0 rounded-xl border border-black/10 text-lg font-bold text-slate/60 hover:bg-black/5">−</button>
                    <input type="text" name="Quantity" value="12" class="w-full text-center py-2.5 rounded-xl border border-black/10 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    <button type="button" class="w-11 h-11 shrink-0 rounded-xl border border-black/10 text-lg font-bold text-slate/60 hover:bg-black/5">+</button>
                </div>

                <div class="mt-auto space-y-2">
                    <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-3 rounded-xl text-sm shadow-sm">
                        ยืนยันรับเข้าสต็อก
                    </button>
                    <p class="text-[11px] text-slate/35 text-center">ยอดคงเหลือของสินค้าจะถูกอัปเดตทันทีหลังยืนยัน</p>
                </div>
            </form>
        </div>

        <!-- SESSION SCAN LOG -->
        <div class="bg-white rounded-2xl border border-black/5 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3 border-b border-black/5">
                <h2 class="text-sm font-bold text-slate flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg>
                    รายการที่สแกนรับเข้าในรอบนี้
                </h2>
                <span class="text-[11px] font-semibold text-slate/40">4 รายการ · รวม 61 ชิ้น</span>
            </div>
            <div class="overflow-x-auto">
                @{
                    var mockScanLogs = new[]
                    {
                        new { Time = "14:31:02", Product = "การ์ดสะสมชุด Sakura Vol.4", Sku = "SKU-CD-3390", Quantity = 24 },
                        new { Time = "14:28:47", Product = "สมุดโน้ตลายดอกไม้ A5", Sku = "SKU-NB-0512", Quantity = 20 },
                        new { Time = "14:26:15", Product = "พวงกุญแจแมวส้ม", Sku = "SKU-KC-0087", Quantity = 5 },
                        new { Time = "14:22:58", Product = "แก้วน้ำลาย Bunny Cafe", Sku = "SKU-CP-4456", Quantity = 12 }
                    };
                }
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-slate/[0.03] text-slate/50 text-xs uppercase tracking-wide">
                            <th class="text-left font-semibold px-4 py-2.5">เวลา</th>
                            <th class="text-left font-semibold px-4 py-2.5">สินค้า</th>
                            <th class="text-left font-semibold px-4 py-2.5">SKU</th>
                            <th class="text-center font-semibold px-4 py-2.5">จำนวนที่รับ</th>
                            <th class="text-center font-semibold px-4 py-2.5">สถานะ</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5">
                        @foreach (var scan in mockScanLogs)
                        {
                            <tr>
                                <td class="px-4 py-2.5 text-slate/50 font-mono text-xs">@scan.Time</td>
                                <td class="px-4 py-2.5 font-medium text-slate">@scan.Product</td>
                                <td class="px-4 py-2.5 font-mono text-xs text-slate/50">@scan.Sku</td>
                                <td class="px-4 py-2.5 text-center font-bold text-slate">+@scan.Quantity</td>
                                <td class="px-4 py-2.5 text-center"><span class="text-[11px] font-bold bg-green-100 text-green-700 px-2.5 py-1 rounded-full">สำเร็จ</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="shrink-0 px-6 py-3 border-t border-black/5 bg-white flex items-center justify-between text-[11px] text-slate/40">
        <span>FriendHouse Staff Console · เข้าสู่ระบบเป็น ณัฐชา ใจดี (พนักงานสต็อก) · กะ 09:00–18:00</span>
        <span>โหมดจำลอง (MOCK) · ไม่มีการเชื่อมต่อฮาร์ดแวร์สแกนเนอร์</span>
    </footer>

</div>
