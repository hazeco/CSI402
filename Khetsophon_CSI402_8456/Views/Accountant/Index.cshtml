@{
    ViewData["Title"] = "ภาพรวมการเงินร้าน";
    Layout = "_AccountantLayout";

    // Top-of-file Media & Content Configuration
    var pageHeader = new {
        Title = "ภาพรวมการเงินร้าน",
        Subtitle = "สรุปรายเดือนสำหรับงานบัญชี — ดูข้อมูลได้อย่างเดียว ไม่สามารถแก้ไขโปรโมชั่นหรือสต็อกจากหน้านี้",
        SelectedMonth = "กันยายน 2569"
    };

    var revenueVal = ViewBag.TotalMonthlyRevenue != null && (decimal)ViewBag.TotalMonthlyRevenue > 0 ? (decimal)ViewBag.TotalMonthlyRevenue : 486250m;
    var costVal = ViewBag.RecordedExpenses != null && (decimal)ViewBag.RecordedExpenses > 0 ? (decimal)ViewBag.RecordedExpenses : 298400m;
    var grossProfitVal = revenueVal - costVal;

    var financeStats = new {
        Revenue = "฿" + revenueVal.ToString("N0"),
        RevenueDelta = ViewBag.StorefrontRevenue != null ? $"หน้าร้าน ฿{((decimal)ViewBag.StorefrontRevenue):N0}" : "▲ +11.0% จากเดือนก่อน",
        Cost = "฿" + costVal.ToString("N0"),
        CostSubtext = "รายจ่ายที่บันทึกในสมุดบัญชี",
        GrossProfit = "฿" + grossProfitVal.ToString("N0"),
        GrossProfitSubtext = "รายได้สุทธิ - รายจ่าย",
        GrossMargin = revenueVal > 0 ? ((grossProfitVal / revenueVal) * 100).ToString("N1") + "%" : "38.6%",
        GrossMarginSubtext = ViewBag.PreordersPendingTotal != null ? $"พรีออเดอร์ค้างรับ ฿{((decimal)ViewBag.PreordersPendingTotal):N0}" : "เทียบเป้าหมาย 35%"
    };

    var dualBarData = new[] {
        new { Month = "เม.ย.", RevHeight = "75%", CostHeight = "55%", IsCurrent = false },
        new { Month = "พ.ค.", RevHeight = "72%", CostHeight = "52%", IsCurrent = false },
        new { Month = "มิ.ย.", RevHeight = "82%", CostHeight = "58%", IsCurrent = false },
        new { Month = "ก.ค.", RevHeight = "85%", CostHeight = "60%", IsCurrent = false },
        new { Month = "ส.ค.", RevHeight = "80%", CostHeight = "56%", IsCurrent = false },
        new { Month = "ก.ย.", RevHeight = "95%", CostHeight = "65%", IsCurrent = true }
    };

    var profitCategories = new[] {
        new { Name = "เสื้อผ้าแฟชั่น", Profit = "฿73,200 กำไร", Pct = "100%" },
        new { Name = "รองเท้า", Profit = "฿44,150 กำไร", Pct = "78%" },
        new { Name = "กระเป๋า/เครื่องประดับ", Profit = "฿40,500 กำไร", Pct = "70%" },
        new { Name = "ของใช้ในบ้าน", Profit = "฿29,000 กำไร", Pct = "52%" }
    };
}

<div class="space-y-6">
    <!-- Header Row (frame_9_23.png) -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
            <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
        </div>

        <!-- Month Filter Controls -->
        <div class="flex items-center gap-2">
            <span class="text-xs text-gray-500 font-medium">เลือกเดือน:</span>
            <div class="relative">
                <select class="appearance-none pr-8 pl-3.5 py-2 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-[#050315] shadow-2xs focus:outline-none">
                    <option>@pageHeader.SelectedMonth</option>
                    <option>สิงหาคม 2569</option>
                    <option>กรกฎาคม 2569</option>
                </select>
                <svg class="size-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>
            <span class="text-xs text-gray-400 bg-gray-100 px-3 py-1.5 rounded-xl font-medium">
                รายเดือนเท่านั้น
            </span>
        </div>
    </div>

    <!-- 4 Stat Cards in a row (frame_9_23.png) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Revenue -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium">รายได้รวมเดือนนี้</span>
                <span class="size-6 rounded-lg bg-purple-50 text-[#7E22CE] text-xs font-bold flex items-center justify-center">฿</span>
            </div>
            <div class="text-3xl font-extrabold text-[#050315]">@financeStats.Revenue</div>
            <div class="text-xs font-semibold text-[#16A34A]">@financeStats.RevenueDelta</div>
        </div>

        <!-- Card 2: Cost -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium">ต้นทุนสินค้าที่รับเข้า</span>
                <span class="size-6 rounded-lg bg-cyan-50 text-[#0E7490] text-xs font-bold flex items-center justify-center">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                </span>
            </div>
            <div class="text-3xl font-extrabold text-[#050315]">@financeStats.Cost</div>
            <div class="text-xs text-gray-400">@financeStats.CostSubtext</div>
        </div>

        <!-- Card 3: Gross Profit -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium">กำไรขั้นต้น</span>
                <span class="size-6 rounded-lg bg-green-50 text-[#16A34A] text-xs font-bold flex items-center justify-center">▲</span>
            </div>
            <div class="text-3xl font-extrabold text-[#16A34A]">@financeStats.GrossProfit</div>
            <div class="text-xs text-gray-400">@financeStats.GrossProfitSubtext</div>
        </div>

        <!-- Card 4: Profit Margin -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium">อัตรากำไรขั้นต้น</span>
                <span class="size-6 rounded-lg bg-blue-50 text-[#2563EB] text-xs font-bold flex items-center justify-center">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </span>
            </div>
            <div class="text-3xl font-extrabold text-[#050315]">@financeStats.GrossMargin</div>
            <div class="text-xs text-gray-400">@financeStats.GrossMarginSubtext</div>
        </div>
    </div>

    <!-- Light Blue Info Alert (frame_9_23.png) -->
    <div class="rounded-2xl bg-[#F0FDF4]/70 border border-[#BAF2FF] p-4 flex items-center gap-3 text-xs text-gray-600 leading-relaxed">
        <svg class="size-5 shrink-0 text-[#0E7490]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>
            ยอด "รายได้รวม" ข้างต้นเป็นยอดสุทธิที่หักส่วนลดจากโปรโมชั่นแล้วทุกประเภท (เคลียร์สต๊อกปลายปี 20–50%, ซื้อ 1 แถม 1, ราคาบันเดิล, แลกแต้มสะสม, พรีออเดอร์) — หน้านี้แสดงผลเพื่อการตรวจสอบทางบัญชีเท่านั้น ไม่สามารถแก้ไขค่าโปรโมชั่นหรือสต็อกได้
        </span>
    </div>

    <!-- 2 Columns Grid: Dual Bar & Category Profit (frame_9_23.png) -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

        <!-- Left 3 Cols: รายได้เทียบต้นทุน 6 เดือนล่าสุด -->
        <div class="lg:col-span-3 bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-bold text-[#050315]">รายได้เทียบต้นทุน 6 เดือนล่าสุด</h2>
                <div class="flex items-center gap-4 text-xs">
                    <span class="flex items-center gap-1.5 text-gray-600 font-medium">
                        <span class="size-2.5 rounded-sm bg-[#2F39A9]"></span> รายได้
                    </span>
                    <span class="flex items-center gap-1.5 text-gray-600 font-medium">
                        <span class="size-2.5 rounded-sm bg-[#92EEFF]"></span> ต้นทุน
                    </span>
                </div>
            </div>

            <!-- Dual Bars Chart -->
            <div class="pt-6 pb-2 h-56 flex items-end justify-between gap-6 max-w-xl mx-auto px-4">
                @foreach (var bar in dualBarData)
                {
                    <div class="flex-1 flex flex-col items-center gap-2 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-1 h-full">
                            <!-- Revenue Bar -->
                            <div class="w-4 rounded-t-sm bg-[#2F39A9] transition-all duration-300" style="height: @bar.RevHeight;"></div>
                            <!-- Cost Bar -->
                            <div class="w-4 rounded-t-sm bg-[#92EEFF] transition-all duration-300" style="height: @bar.CostHeight;"></div>
                        </div>
                        <span class="text-xs font-semibold @(bar.IsCurrent ? "text-[#050315] font-bold" : "text-gray-400")">
                            @bar.Month
                        </span>
                    </div>
                }
            </div>
        </div>

        <!-- Right 2 Cols: สรุปกำไรตามหมวดหมู่สินค้า -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-xs p-6 flex flex-col justify-between space-y-4">
            <div>
                <h2 class="text-sm font-bold text-[#050315] mb-5">สรุปกำไรตามหมวดหมู่สินค้า</h2>
                <div class="space-y-4">
                    @foreach (var cat in profitCategories)
                    {
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="font-medium text-[#050315]">@cat.Name</span>
                                <span class="font-bold text-gray-600">@cat.Profit</span>
                            </div>
                            <div class="w-full h-2 rounded-full bg-gray-100 overflow-hidden">
                                <div class="h-full rounded-full bg-[#2F39A9]" style="width: @cat.Pct;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100">
                <a asp-controller="Accountant" asp-action="Receipts"
                   class="text-xs font-bold text-[#2F39A9] hover:underline inline-flex items-center gap-1 cursor-pointer">
                    <span>ดูรายละเอียดเต็มในหน้าประวัติใบเสร็จ</span>
                    <span>→</span>
                </a>
            </div>
        </div>
    </div>
</div>
