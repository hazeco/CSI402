@{
    ViewData["Title"] = "Lab 4";
    Layout = "_StaffLayout";
}

<div class="mx-auto max-w-[980px] rounded-[1.25rem] p-4 shadow-[0_12px_28px_rgba(15,23,42,0.22)]">
    <div class="rounded-[1rem] border border-slate-200 bg-[#f3f3f3] p-5">
        <div class="mb-6 flex items-center justify-between">
            <h2 class="text-[2.1rem] font-bold leading-none text-slate-800">เพิ่มผู้ใช้งานใหม่</h2>
            <button type="button" class="text-4xl font-light leading-none text-slate-500 hover:text-slate-700">×</button>
        </div>

        <form class="space-y-5">
            <div>
                <label class="mb-2 block text-[1.05rem] font-medium text-slate-700">ประเภทผู้ใช้งาน <span class="">(Role)</span></label>
                <div class="grid grid-cols-2 gap-2 rounded-xl bg-slate-200 p-2 md:grid-cols-4">
                    <button type="button" class="rounded-xl bg-white px-4 py-3 text-base font-medium text-slate-700 shadow-sm ring-1 ring-slate-200 transition hover:bg-slate-50">
                        Staff
                    </button>
                    <button type="button" class="rounded-xl px-4 py-3 text-base font-medium text-slate-600 transition hover:bg-slate-50">
                        IT
                    </button>
                    <button type="button" class="rounded-xl px-4 py-3 text-base font-medium text-slate-600 transition hover:bg-slate-50">
                        Owner
                    </button>
                    <button type="button" class="rounded-xl px-4 py-3 text-base font-medium text-slate-600 transition hover:bg-slate-50">
                        Customer
                    </button>
                </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label for="firstName" class="mb-2 block text-[1.05rem] font-medium text-slate-700">ชื่อจริง <span class="text-red-500 hidden">*</span></label>
                    <input id="firstName" type="text" placeholder="ระบุชื่อจริง" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-base text-slate-600 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-200" />
                </div>
                <div>
                    <label for="lastName" class="mb-2 block text-[1.05rem] font-medium text-slate-700">นามสกุล <span class="text-red-500 hidden">*</span></label>
                    <input id="lastName" type="text" placeholder="ระบุนามสกุล" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-base text-slate-600 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-200" />
                </div>
            </div>

            <div>
                <label for="email" class="mb-2 block text-[1.05rem] font-medium text-slate-700">อีเมล <span class="text-red-500">*</span></label>
                <div class="flex items-center gap-3 rounded-xl border border-slate-300 bg-white px-3 py-3">
                    <span class="text-lg text-slate-500">✉</span>
                    <input id="email" type="email" placeholder="ตัวอย่าง: sarah.p@email.com" class="w-full bg-transparent text-base text-slate-600 placeholder:text-slate-400 focus:outline-none" />
                </div>
            </div>

            <div>
                <label for="phone" class="mb-2 block text-[1.05rem] font-medium text-slate-700">เบอร์โทรศัพท์ <span class="text-red-500">*</span></label>
                <div class="flex items-center gap-3 rounded-xl border border-slate-300 bg-white px-3 py-3">
                    <span class="text-lg text-slate-500">☎</span>
                    <input id="phone" type="tel" placeholder="081-XXX-XXXX" class="w-full bg-transparent text-base text-slate-600 placeholder:text-slate-400 focus:outline-none" />
                </div>
            </div>

            <div>
                <label for="password" class="mb-2 block text-[1.05rem] font-medium text-slate-700">รหัสผ่าน <span class="text-red-500">*</span></label>
                <div class="flex items-center gap-3 rounded-xl border border-slate-300 bg-white px-3 py-3">
                    <span class="text-lg text-slate-500">🔒</span>
                    <input id="password" type="password" placeholder="อย่างน้อย 8 ตัวอักษร" class="w-full bg-transparent text-base text-slate-600 placeholder:text-slate-400 focus:outline-none" />
                    <button type="button" class="text-xl text-slate-500 hover:text-slate-700" aria-label="Toggle password visibility">◉</button>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button type="button" class="rounded-xl border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50">
                    ยกเลิก
                </button>
                <button type="submit" class="rounded-xl bg-[#1d3b8e] px-7 py-3 text-base font-semibold text-white shadow-md transition hover:bg-[#18307a]">
                    บันทึกข้อมูล
                </button>
            </div>
        </form>
    </div>
</div>

<div class="container mx-auto px-4 py-8">
    <div class="mb-8">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-red-500">overview</p>
        <h1 class="mt-2 text-2xl font-bold text-slate-800">ติดต่อร้าน</h1>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">อีเมล</p>
            <p class="mt-3 text-lg font-semibold text-slate-800">contact@shop.com</p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">เบอร์โทร</p>
            <p class="mt-3 text-lg font-semibold text-slate-800">012-345-6789</p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">สถานะ</p>
            <div class="mt-3 inline-flex rounded-full bg-green-100 px-2.5 py-1 text-sm font-medium text-green-700">
                ปกติ
            </div>
        </div>
    </div>

    <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full border-collapse text-left text-sm text-slate-700">
            <thead class="bg-slate-50 text-slate-700">
                <tr>
                    <th class="border-b border-slate-200 px-4 py-3 font-semibold">อีเมล</th>
                    <th class="border-b border-slate-200 px-4 py-3 font-semibold">เบอร์โทรศัพท์</th>
                    <th class="border-b border-slate-200 px-4 py-3 font-semibold">สถานะบัญชี</th>
                    <th class="border-b border-slate-200 px-4 py-3 font-semibold">วันที่สมัคร</th>
                    <th class="border-b border-slate-200 px-4 py-3 font-semibold">เข้าสู่ระบบ</th>
                    <th class="border-b border-slate-200 px-4 py-3 font-semibold">การช่วยเหลือ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in new[] {
                    new { Email = "fakeemail@example.com", Phone = "012-345-6789", Status = "ปกติ", RegistrationDate = "12 ตุลาคม 2023", LastLogin = "วันนี้ 9:00 น.", Help = "ช่วยรีเซ็ตรหัสผ่าน" },
                    new { Email = "gg@email.com", Phone = "012-345-6789", Status = "ปกติ", RegistrationDate = "12 ตุลาคม 2023", LastLogin = "วันนี้ 9:00 น.", Help = "ช่วยรีเซ็ตรหัสผ่าน" },
                    new { Email = "aa@email.com", Phone = "012-345-6789", Status = "ถูกล็อค", RegistrationDate = "12 ตุลาคม 2023", LastLogin = "วันนี้ 9:00 น.", Help = "ช่วยรีเซ็ตรหัสผ่าน" }
                })
                {
                    var isActive = user.Status == "ปกติ";
                    var isInactive = user.Status == "ถูกล็อค";
                    var statusClass = isActive ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-700";

                    <tr class="hover:bg-slate-50">
                        <td class="border-b border-slate-200 px-4 py-3">@user.Email</td>
                        <td class="border-b border-slate-200 px-4 py-3">@user.Phone</td>
                        <td class="border-b border-slate-200 px-4 py-3">
                            <span class="inline-flex rounded-full px-2 py-1 text-xs font-medium @statusClass">
                                @user.Status
                            </span>
                        </td>
                        <td class="border-b border-slate-200 px-4 py-3">@user.RegistrationDate</td>
                        <td class="border-b border-slate-200 px-4 py-3">@user.LastLogin</td>
                        <td class="border-b border-slate-200 px-4 py-3">@user.Help</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>