@{
    ViewData["Title"] = "Lab2";
}

<div class="h-dvh">
    <h1 class="text-3xl font-bold text-gray-900">Lab2</h1>

<dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-gray-700">
    <dt class="font-medium text-gray-900">Fullname</dt>
    <dd>@ViewBag.fullName</dd>
    <dt class="font-medium text-gray-900">RoomNumber</dt>
    <dd>@ViewBag.roomNumber</dd>
    <dt class="font-medium text-gray-900">Programlanguage</dt>
    <dd>@ViewBag.programlanguage</dd>
    <dt class="font-medium text-gray-900">Year</dt>
    <dd>@ViewBag.year</dd>
    <dt class="font-medium text-gray-900">Grade</dt>
    <dd>@ViewBag.Grade</dd>
</dl>

@if (ViewBag.Grade == "F")
{
    <h6 class="mt-6 text-sm font-semibold text-red-600">Work that lower than 5 point</h6>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-700">
        @foreach (var item in ViewBag.workFaileds)
        {
            <li>งานที่ @item</li>
        }
    </ul>
}
</div>