@model Khetsophon_CSI402_8456.Models.Labstudent

<form asp-action="Lab9" asp-controller="Home">
    StudentID<input type="text" asp-for="StdId" class="form-control" /><br/>
    Password<input type="password" asp-for="StdPassword" class="form-control" /><br/>
    Firstname<input type="text" asp-for="StdName" class="form-control" /><br/>
    Lastname<input type="text" asp-for="StdLastname" class="form-control" /><br/>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

@if (ViewBag.Status != null)
{
    <p style="color: red; margin-top: 10px;">@ViewBag.Status</p>
}