@model Khetsophon_CSI402_8456.Models.Labstudent
@{
    ViewData["Title"] = "เพิ่มข้อมูลนักศึกษา (Lab 9)";

    var pageConfig = new {
        Title = "เพิ่มข้อมูลนักศึกษาใหม่",
        Subtitle = "แบบฟอร์มบันทึกข้อมูลนักศึกษาเข้าสู่ระบบ (Lab 9 - Create)",
        Icons = new {
            Id = "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
            Lock = "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
            Name = "M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z",
            Back = "M10 19l-7-7m0 0l7-7m-7 7h18",
            Save = "M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4",
            Alert = "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
        },
        Labels = new {
            StdId = "รหัสนักศึกษา",
            StdPassword = "รหัสผ่าน",
            StdName = "ชื่อจริง",
            StdLastname = "นามสกุล",
            SubmitBtn = "บันทึกข้อมูลนักศึกษา",
            BackBtn = "ดูรายชื่อนักศึกษาทั้งหมด (Lab 9.1)"
        }
    };
}

<div class="min-h-screen bg-background py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl mx-auto">
        <!-- การ์ดส่วนหัวแบบฟอร์ม -->
        <div class="mb-6 flex items-center justify-between">
            <a asp-action="Lab9_1" asp-controller="Home" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-accent transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="@pageConfig.Icons.Back"></path>
                </svg>
                <span>@pageConfig.Labels.BackBtn</span>
            </a>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
                Lab 9 : Create
            </span>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <!-- หัวข้อการ์ด -->
            <div class="p-6 sm:p-8 border-b border-slate-100 bg-gradient-to-r from-primary/5 via-white to-secondary/10">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-primary text-white flex items-center justify-center shrink-0 shadow-md">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="@pageConfig.Icons.Name"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold text-text">@pageConfig.Title</h1>
                        <p class="text-xs sm:text-sm text-slate-500 mt-1">@pageConfig.Subtitle</p>
                    </div>
                </div>
            </div>

            <div class="p-6 sm:p-8 space-y-6">
                <!-- กล่องข้อความแจ้งเตือนสถานะ -->
                @if (ViewBag.Status != null)
                {
                    <div class="rounded-xl bg-rose-50 border border-rose-200 p-4 flex items-center gap-3 text-rose-700 text-sm">
                        <svg class="w-5 h-5 shrink-0 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="@pageConfig.Icons.Alert"></path>
                        </svg>
                        <span class="font-medium">@ViewBag.Status</span>
                    </div>
                }

                <!-- ฟอร์มลงทะเบียน  -->
                <form class="space-y-5" asp-action="Lab9" asp-controller="Home">
                    <!-- รหัสนักศึกษา -->
                    <div>
                        <label class="block text-xs font-semibold text-text mb-1.5">@pageConfig.Labels.StdId</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="@pageConfig.Icons.Id"></path>
                                </svg>
                            </div>
                            <input type="text" asp-for="StdId" placeholder="เช่น 6401001" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                        </div>
                    </div>

                    <!-- รหัสผ่าน -->
                    <div>
                        <label class="block text-xs font-semibold text-text mb-1.5">@pageConfig.Labels.StdPassword</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="@pageConfig.Icons.Lock"></path>
                                </svg>
                            </div>
                            <input type="password" asp-for="StdPassword" placeholder="กำหนดรหัสผ่าน" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- ชื่อ -->
                        <div>
                            <label class="block text-xs font-semibold text-text mb-1.5">@pageConfig.Labels.StdName</label>
                            <input type="text" asp-for="StdName" placeholder="ชื่อจริง" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                        </div>

                        <!-- นามสกุล -->
                        <div>
                            <label class="block text-xs font-semibold text-text mb-1.5">@pageConfig.Labels.StdLastname</label>
                            <input type="text" asp-for="StdLastname" placeholder="นามสกุล" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                        </div>
                    </div>

                    <!-- ปุ่มส่งข้อมูล -->
                    <div class="pt-3">
                        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-primary text-white font-semibold text-sm hover:bg-accent focus:outline-none focus:ring-4 focus:ring-primary/20 shadow-md hover:shadow-lg transition-all cursor-pointer">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="@pageConfig.Icons.Save"></path>
                            </svg>
                            <span>@pageConfig.Labels.SubmitBtn</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>