@model Khetsophon_CSI402_8456.Models.Labstudent
@{
    ViewData["Title"] = "แก้ไขข้อมูลนักศึกษา (Lab 10)";

    var pageConfig = new {
        Title = "แก้ไขข้อมูลนักศึกษา",
        Subtitle = "ปรับปรุงข้อมูลนักศึกษาในระบบฐานข้อมูล (Lab 10 - Update)",
        Icons = new {
            Id = "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
            Lock = "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
            Edit = "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
            Back = "M10 19l-7-7m0 0l7-7m-7 7h18",
            Save = "M5 13l4 4L19 7"
        },
        Labels = new {
            StdId = "รหัสนักศึกษา (ไม่สามารถแก้ไขได้)",
            StdPassword = "รหัสผ่านใหม่",
            StdName = "ชื่อจริง",
            StdLastname = "นามสกุล",
            SubmitBtn = "บันทึกการแก้ไขข้อมูล",
            BackBtn = "ยกเลิก / กลับหน้ารายชื่อ (Lab 9.1)"
        }
    };
}

<div class="min-h-screen bg-background py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl mx-auto">
        <!-- ลิงก์ย้อนกลับและ Badge -->
        <div class="mb-6 flex items-center justify-between">
            <a asp-action="Lab9_1" asp-controller="Home" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-accent transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="@pageConfig.Icons.Back"></path>
                </svg>
                <span>@pageConfig.Labels.BackBtn</span>
            </a>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-secondary/30 text-primary border border-secondary">
                Lab 10 : Update
            </span>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <!-- ส่วนหัวการ์ด -->
            <div class="p-6 sm:p-8 border-b border-slate-100 bg-gradient-to-r from-primary/5 via-white to-secondary/10">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-primary text-white flex items-center justify-center shrink-0 shadow-md">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="@pageConfig.Icons.Edit"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold text-text">@pageConfig.Title</h1>
                        <p class="text-xs sm:text-sm text-slate-500 mt-1">@pageConfig.Subtitle</p>
                    </div>
                </div>
            </div>

            <div class="p-6 sm:p-8 space-y-6">
                <!-- ฟอร์มแก้ไขข้อมูล (ห้ามใส่แอตทริบิวต์ method ตามกฎโปรเจกต์) -->
                <form class="space-y-5" asp-action="Lab10" asp-controller="Home">
                    <!-- รหัสนักศึกษา (Readonly) -->
                    <div>
                        <label class="block text-xs font-semibold text-text mb-1.5">@pageConfig.Labels.StdId</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="@pageConfig.Icons.Id"></path>
                                </svg>
                            </div>
                            <input readonly type="text" asp-for="StdId" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-slate-100/80 text-sm text-slate-600 font-medium cursor-not-allowed select-none" />
                        </div>
                    </div>

                    <!-- รหัสผ่านใหม่ -->
                    <div>
                        <label class="block text-xs font-semibold text-text mb-1.5">@pageConfig.Labels.StdPassword</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="@pageConfig.Icons.Lock"></path>
                                </svg>
                            </div>
                            <input type="password" asp-for="StdPassword" placeholder="กรอกรหัสผ่านใหม่" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- ชื่อ -->
                        <div>
                            <label class="block text-xs font-semibold text-text mb-1.5">@pageConfig.Labels.StdName</label>
                            <input type="text" asp-for="StdName" placeholder="ชื่อจริง" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                        </div>

                        <!-- นามสกุล -->
                        <div>
                            <label class="block text-xs font-semibold text-text mb-1.5">@pageConfig.Labels.StdLastname</label>
                            <input type="text" asp-for="StdLastname" placeholder="นามสกุล" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                        </div>
                    </div>

                    <!-- ปุ่มบันทึก -->
                    <div class="pt-3 flex flex-col sm:flex-row items-center gap-3">
                        <button type="submit" class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-primary text-white font-semibold text-sm hover:bg-accent focus:outline-none focus:ring-4 focus:ring-primary/20 shadow-md hover:shadow-lg transition-all cursor-pointer">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="@pageConfig.Icons.Save"></path>
                            </svg>
                            <span>@pageConfig.Labels.SubmitBtn</span>
                        </button>
                        <a asp-action="Lab9_1" asp-controller="Home" class="w-full sm:w-auto inline-flex items-center justify-center py-3 px-6 rounded-xl border border-slate-300 bg-white text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-all text-center">
                            ยกเลิก
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>