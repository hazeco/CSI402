<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4 pb-8 space-y-8 bg-white">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="แถบนำทาง">
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">หน้าแรก</a>
        <span>/</span>
        @if (isRewardItem)
        {
            <a asp-controller="Home" asp-action="Rewards" class="hover:text-primary transition-colors">แคตตาล็อกแลกแต้มสะสม</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Collection" class="hover:text-primary transition-colors">สินค้าทั้งหมด</a>
        }
        <span>/</span>
        <span class="text-text font-semibold truncate">@product.Name</span>
    </nav>

    <!-- Main Product Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
        <!-- Left: Product Media Gallery (Edge-to-edge, full cover image stretching to match right column height) -->
        <div class="lg:col-span-6 flex flex-col h-full">
            <div class="relative aspect-square sm:aspect-4/3 lg:aspect-auto w-full h-full min-h-[260px] sm:min-h-[400px] lg:min-h-0 flex-1 rounded-3xl border border-slate-200/80 bg-slate-100 overflow-hidden shadow-xs">
                <!-- Status Badge -->
                <div class="absolute top-4 left-4 z-10 rounded-full bg-emerald-100 px-3.5 py-1 text-xs font-bold text-emerald-700 shadow-xs flex items-center gap-1.5 backdrop-blur-xs">
                    <span class="size-2 rounded-full bg-emerald-500"></span>
                    <span>@product.Status</span>
                </div>

                <!-- Full Edge-to-Edge Image -->
                <img src="@Url.Content(product.ImageUrl)" alt="@product.Name"
                     class="size-full object-cover object-center" />
            </div>
        </div>

        <!-- Right: Product Information & Pre-order Action -->
        <div class="lg:col-span-6 space-y-6">
            <div>
                <span class="text-xs font-semibold text-primary uppercase tracking-wide">@product.Series • @product.Category</span>
                <h1 class="mt-1 text-2xl sm:text-3xl font-extrabold text-text tracking-tight">@product.Name</h1>
                <div class="mt-3 text-3xl font-extrabold text-primary">@product.Price</div>
            </div>

            <!-- Description -->
            <p class="text-sm sm:text-base leading-relaxed text-slate-600">
                @product.Description
            </p>

            <!-- Specs Table -->
            <div class="rounded-2xl border border-slate-200/80 bg-white p-4 space-y-3 shadow-xs">
                @foreach (var spec in product.Specs)
                {
                    <div class="flex items-center justify-between text-xs sm:text-sm py-1 border-b border-slate-100 last:border-0">
                        <span class="font-medium text-slate-400">@spec.Label</span>
                        <span class="font-semibold text-text">@spec.Value</span>
                    </div>
                }
            </div>

            <!-- Action Buttons: พรีออเดอร์สินค้านี้ หรือ แลกของรางวัลนี้ (Responsive stacked/inline) -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 pt-2">
                <!-- Open Pre-order / Redeem Modal Button -->
                <button type="button" id="btn-open-preorder-modal"
                        class="flex-1 w-full sm:w-auto rounded-xl bg-accent px-6 py-3.5 text-center text-sm font-bold text-white shadow-lg shadow-accent/25 transition-all hover:bg-accent/90 hover:-translate-y-0.5 cursor-pointer">
                    @(isRewardItem ? "แลกของรางวัลนี้" : "สั่งจองสินค้านี้")
                </button>

                @if (isRewardItem)
                {
                    <!-- Back to Rewards Link -->
                    <a asp-controller="Home" asp-action="Rewards"
                       class="w-full sm:w-auto text-center rounded-xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-semibold text-text shadow-xs transition-colors hover:bg-slate-50 cursor-pointer">
                        ดูของรางวัลอื่น
                    </a>
                }
                else
                {
                    <!-- Add to Cart Link -->
                    <a asp-controller="Home" asp-action="Cart"
                       class="w-full sm:w-auto text-center rounded-xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-semibold text-text shadow-xs transition-colors hover:bg-slate-50 cursor-pointer">
                        เพิ่มลงตะกร้า
                    </a>
                }
            </div>

            <!-- Pre-order / Reward Explanation Notice -->
            <div class="rounded-2xl border border-primary/15 bg-primary/5 p-4 flex gap-3.5 items-start">
                <div class="flex size-6 shrink-0 items-center justify-center rounded-lg bg-primary text-white mt-0.5">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                </div>
                <p class="text-xs sm:text-sm leading-relaxed text-slate-600">
                    @notice
                </p>
            </div>
        </div>
    </div>
</div>

<!-- PRE-ORDER / REDEEM CONFIRMATION MODAL -->
<div id="preorder-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs transition-opacity" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="relative w-full max-w-lg rounded-3xl bg-white p-6 sm:p-8 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div>
            <h2 id="modal-title" class="text-xl sm:text-2xl font-extrabold text-text">
                @(isRewardItem ? "ยืนยันการแลกของรางวัล" : "บันทึกสิทธิ์จองสินค้า")
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                @(isRewardItem ? "ใช้แต้มสะสมและรับสินค้าตัวจริงที่หน้าร้าน FriendHouse สยามสแควร์" : "ชำระเงินและรับสินค้าตัวจริงที่หน้าร้าน FriendHouse สยามสแควร์")
            </p>
        </div>

        <!-- Order Summary Card -->
        <div class="flex items-center gap-4 rounded-2xl border border-slate-200/80 bg-slate-50 p-4">
            <img src="@Url.Content(product.ImageUrl)" alt="@product.Name" class="size-16 rounded-xl object-cover border border-slate-200 shrink-0" />
            <div class="min-w-0 flex-1">
                <h4 class="text-sm font-bold text-text truncate">@product.Name</h4>
                <div class="text-xs text-slate-400 mt-0.5">จำนวน: 1 ชิ้น</div>
                <div class="text-sm font-extrabold text-primary mt-1">@product.Price</div>
            </div>
        </div>

        <!-- Appointment Form (No method attribute per rule) -->
        @* Form Parameters expected by Controller:
           [PickupDate: DateTime, ContactPhone: string, ProductId: int, Quantity: int]
        *@
        <form asp-controller="Home" asp-action="PreorderStatus" class="space-y-4">
            <div>
                <label for="pickupDate" class="block text-xs font-bold text-slate-700 mb-1">วันที่สะดวกเข้ารับสินค้าโดยประมาณ</label>
                <input type="date" id="pickupDate"
                       class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-text focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <div>
                <label for="contactPhone" class="block text-xs font-bold text-slate-700 mb-1">เบอร์โทรศัพท์สำหรับรับ SMS แจ้งเตือนเมื่อสินค้าถึงร้าน</label>
                <input type="tel" id="contactPhone" placeholder="08x-xxx-xxxx" value="081-234-5678"
                       class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-text focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <div class="pt-2 flex items-center justify-end gap-3">
                <button type="button" id="btn-cancel-modal" class="rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer">
                    ยกเลิก
                </button>
                <button type="submit" class="rounded-xl bg-accent px-6 py-2.5 text-xs font-bold text-white shadow-xs hover:opacity-90 transition-opacity cursor-pointer">
                    @(isRewardItem ? "ยืนยันการใช้แต้มแลก &rarr;" : "ยืนยันการจอง &rarr;")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('preorder-modal');
        var openBtn = document.getElementById('btn-open-preorder-modal');
        var closeBtn = document.getElementById('btn-close-preorder-modal');
        var cancelBtn = document.getElementById('btn-cancel-modal');

        function openModal() {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        if (openBtn) openBtn.addEventListener('click', openModal);
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

        window.addEventListener('click', function (e) {
            if (e.target === modal) {
                closeModal();
            }
        });
    });
</script>
}
