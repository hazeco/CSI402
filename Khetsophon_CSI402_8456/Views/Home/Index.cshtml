<div class="space-y-12 pb-16 bg-white">
    <!-- HERO SECTION WITH 3D MODEL -->
    <section id="hero" class="relative overflow-hidden pt-8 pb-12 sm:pt-12 sm:pb-16 lg:pt-14 lg:pb-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
                <!-- Left: Hero Text & Specs -->
                <div class="order-2 lg:order-1 lg:col-span-7 flex flex-col justify-center">
                    <!-- Eyebrow Badge -->
                    <!-- Eyebrow Badge (มีสินค้า) -->
                    <div class="inline-flex items-center gap-2 self-start rounded-full bg-emerald-100 px-3.5 py-1 text-xs font-bold tracking-wide text-emerald-800 mb-4 shadow-xs">
                        <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>@heroContent.Badge</span>
                    </div>

                    <!-- Main Heading -->
                    <h1 class="text-3xl font-extrabold tracking-tight text-text sm:text-4xl lg:text-5xl leading-tight">
                        @heroContent.TitlePrefix<br />
                        <span class="text-primary">@heroContent.TitleHighlight</span>
                    </h1>

                    <!-- Description -->
                    <p class="mt-4 max-w-2xl text-sm sm:text-base leading-relaxed text-slate-600">
                        @heroContent.Description
                    </p>

                    <!-- Specifications Grid -->
                    <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-xl">
                        @foreach (var spec in heroContent.Specs)
                        {
                            <div class="rounded-xl border border-slate-200/80 bg-white p-3 shadow-xs text-center transition-all hover:border-primary/30">
                                <div class="text-base font-bold text-text">@spec.Value</div>
                                <div class="text-[11px] font-medium text-slate-400 uppercase tracking-wider mt-0.5">@spec.Label</div>
                            </div>
                        }
                    </div>

                    <!-- Pricing & CTA Buttons (Responsive stacked/inline buttons) -->
                    <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4">
                        <div class="mr-2">
                            <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">@heroContent.PriceLabel</span>
                            <span class="text-3xl font-extrabold text-primary">@heroContent.Price</span>
                        </div>

                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
                            <!-- Button 1 (Left): ใส่ตะกร้า -->
                            <a asp-controller="Home" asp-action="Cart"
                               class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary/30 bg-white px-5 py-3.5 text-sm font-bold text-primary shadow-xs transition-all hover:bg-primary/5 cursor-pointer w-full sm:w-auto">
                                <svg class="size-4.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span>ใส่ตะกร้า</span>
                            </a>

                            <!-- Button 2 (Right): พรีออเดอร์สินค้านี้ -->
                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="201"
                               class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-accent/25 transition-all hover:bg-accent/90 hover:-translate-y-0.5 cursor-pointer w-full sm:w-auto">
                                <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path>
                                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                </svg>
                                <span>สั่งจองสินค้านี้</span>
                            </a>
                        </div>
                    </div>

                    <!-- Trust Note -->
                    <div class="mt-5 flex items-center gap-2 text-xs text-slate-500 font-medium">
                        <span class="size-2 rounded-full bg-emerald-500 shrink-0"></span>
                        <span>@heroContent.Notice</span>
                    </div>
                </div>

                <!-- Right: 3D Model Viewer Container -->
                <div class="order-1 lg:order-2 lg:col-span-5 flex justify-center">
                    <div class="relative w-full max-w-[500px] h-[340px] sm:h-[480px] lg:h-[620px] rounded-3xl p-2 sm:p-3">
                        <!-- Glow Backdrop -->
                        <div class="absolute inset-4 rounded-full bg-gradient-to-tr from-secondary/40 via-accent/15 to-transparent blur-2xl pointer-events-none"></div>

                        <!-- 3D Model Badge -->
                        <div class="absolute top-6 right-6 z-20 flex items-center gap-1.5 rounded-full bg-primary/90 backdrop-blur-md px-3 py-1.5 text-xs font-bold text-white shadow-md">
                            <span>3D · ลากเพื่อหมุน</span>
                        </div>

                        <!-- Model-Viewer Element -->
                        <div class="relative z-10 w-full h-full rounded-2xl overflow-hidden flex items-center justify-center">
                            <model-viewer
                                id="narutoModelViewer"
                                src="@Url.Content(pageMedia.NarutoModelUrl)"
                                alt="ฟิกเกอร์นารูโตะ โหมดคิวบิเซจ แบบ 3 มิติ หมุนดูได้รอบตัว"
                                camera-controls
                                auto-rotate
                                auto-rotate-delay="800"
                                rotation-per-second="20deg"
                                interaction-prompt="none"
                                shadow-intensity="1.2"
                                exposure="1.1"
                                camera-orbit="0deg 75deg 105%"
                                field-of-view="30deg"
                                loading="eager"
                                reveal="auto"
                                class="w-full h-full cursor-grab active:cursor-grabbing">
                            </model-viewer>

                            <!-- Drag / Zoom Hint Pill -->
                            <div class="pointer-events-none absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1.5 rounded-full border border-slate-200/80 bg-white/95 px-3.5 py-1.5 text-xs font-semibold text-primary shadow-md backdrop-blur-sm whitespace-nowrap">
                                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>
                                </svg>
                                <span>ลาก / บีบซูมเพื่อดูรอบตัว</span>
                            </div>

                            <!-- Fallback Container if WebGL is unavailable -->
                            <div id="narutoFallback" class="hidden absolute inset-0 z-10 flex-col items-center justify-center p-6 text-center bg-slate-50/90 rounded-2xl">
                                <div class="size-16 rounded-2xl bg-secondary/30 flex items-center justify-center mb-3">
                                    <svg class="size-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path>
                                    </svg>
                                </div>
                                <h4 class="font-bold text-text text-base">โมเดล 3D นารูโตะ อุซึมากิ</h4>
                                <p class="text-xs text-slate-500 mt-1 max-w-xs">สามารถดูและหมุนโมเดลบนเบราว์เซอร์ที่รองรับ WebGL</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TRUST STRIP -->
    <div class="border-y border-slate-200/80 bg-white/60 backdrop-blur-xs py-4">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                @foreach (var item in trustItems)
                {
                    <div class="flex items-center gap-3">
                        <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-primary">
                            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="@item.SvgPath"></path>
                            </svg>
                        </div>
                        <span class="text-xs sm:text-sm font-semibold text-slate-700 leading-snug">@item.Title</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- PROMOTIONS SECTION -->
    <section id="promotions" class="scroll-mt-24 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
            <div>
                <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">โปรโมชั่นตอนนี้</h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">5 สิทธิพิเศษเงื่อนไขคุ้มค่า — สำหรับสมาชิก FriendHouse</p>
            </div>
            <a asp-controller="Home" asp-action="Promotion" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline self-start sm:self-auto">
                <span>ดูโปรโมชั่นทั้งหมด</span>
                <svg class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            @foreach (var promo in promoCards)
            {
                <div class="group rounded-2xl border @promo.BgColor p-4.5 shadow-xs transition-all hover:-translate-y-1 hover:shadow-md hover:border-primary/40 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <span class="rounded-lg @promo.BadgeColor px-2.5 py-1 text-[11px] font-bold">@promo.Tag</span>
                            <div class="flex size-7 items-center justify-center rounded-lg bg-slate-100 shadow-xs @promo.IconColor">
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="@promo.SvgPath"></path>
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-sm font-bold text-text group-hover:text-primary transition-colors">@promo.Title</h3>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed">@promo.Desc</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- FEATURED PRODUCTS SECTION -->
    <section id="collection" class="scroll-mt-24 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">สินค้าและฟิกเกอร์แนะนำ</h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">สินค้าพรีออเดอร์และของสะสมยอดนิยมประจำสัปดาห์</p>
            </div>

            <!-- Filter Pills -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0">
                <button type="button" class="rounded-full bg-primary px-4 py-1.5 text-xs font-semibold text-white shadow-xs cursor-pointer">
                    ทั้งหมด
                </button>
                <button type="button" class="rounded-full bg-slate-100 px-4 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-200 transition-colors cursor-pointer">
                    มีสินค้า
                </button>
                <button type="button" class="rounded-full bg-slate-100 px-4 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-200 transition-colors cursor-pointer">
                    สั่งจองสินค้านี้
                </button>
                <a asp-controller="Home" asp-action="Collection" class="ml-2 hidden sm:inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline">
                    ดูคอลเลกชันทั้งหมด &rarr;
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var prod in featuredProducts)
            {
                <div class="group flex flex-col justify-between rounded-3xl border border-slate-200/80 bg-white p-5 shadow-xs transition-all hover:-translate-y-1 hover:shadow-lg">
                    <div>
                        <!-- Real Image Box with Badge (Full edge-to-edge, borderless inside container) -->
                        <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@prod.Id" class="relative block aspect-square w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-100">
                            <span class="absolute top-3 left-3 z-10 rounded-md @prod.BadgeClass px-2.5 py-1 text-[10px] font-bold shadow-xs backdrop-blur-xs">
                                @prod.Badge
                            </span>

                            <img src="@Url.Content(prod.ImageUrl)" alt="@prod.Title"
                                 class="size-full object-cover"
                                 loading="lazy" />
                        </a>

                        <!-- Product Info -->
                        <div class="mt-4">
                            <span class="text-[11px] font-medium text-slate-400">@prod.Series</span>
                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@prod.Id" class="block">
                                <h3 class="mt-1 text-sm font-bold text-text leading-snug group-hover:text-primary transition-colors line-clamp-2">
                                    @prod.Title
                                </h3>
                            </a>
                        </div>
                    </div>

                    <!-- 2 Buttons Row (Cart + Action) -->
                    <div class="mt-4 pt-3 border-t border-slate-100 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-slate-400">ราคา</span>
                            <span class="text-lg font-extrabold text-primary">@prod.Price</span>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <!-- Button 1: ตะกร้า -->
                            <a asp-controller="Home" asp-action="Cart"
                               class="flex items-center justify-center gap-1.5 rounded-xl border border-primary/20 bg-primary/5 py-2.5 text-xs font-bold text-primary transition-colors hover:bg-primary/15 cursor-pointer">
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span>ตะกร้า</span>
                            </a>

                            <!-- Button 2: พรีออเดอร์สินค้านี้ -->
                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@prod.Id"
                               class="flex items-center justify-center rounded-xl bg-accent py-2.5 text-xs font-bold text-white shadow-xs transition-opacity hover:opacity-90 cursor-pointer">
                                สั่งจองสินค้านี้
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Smooth slide scroll handler for any anchor linking to on-page hash
        document.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
            anchor.addEventListener('click', function (e) {
                var targetId = this.getAttribute('href');
                if (targetId && targetId !== '#') {
                    var targetEl = document.querySelector(targetId);
                    if (targetEl) {
                        e.preventDefault();
                        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        if (history.pushState) {
                            history.pushState(null, null, targetId);
                        }
                    }
                }
            });
        });

        // Check if page loaded with a hash and smooth scroll to it
        if (window.location.hash) {
            var initialTarget = document.querySelector(window.location.hash);
            if (initialTarget) {
                setTimeout(function () {
                    initialTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 150);
            }
        }

        var viewer = document.getElementById('narutoModelViewer');
        var fallback = document.getElementById('narutoFallback');

        function hasWebGL() {
            try {
                var canvas = document.createElement('canvas');
                return !!(window.WebGLRenderingContext &&
                    (canvas.getContext('webgl') || canvas.getContext('experimental-webgl') || canvas.getContext('webgl2')));
            } catch (e) {
                return false;
            }
        }

        if (!hasWebGL() && fallback && viewer) {
            viewer.classList.add('hidden');
            fallback.classList.remove('hidden');
            fallback.classList.add('flex');
        } else if (viewer && fallback) {
            viewer.addEventListener('error', function () {
                viewer.classList.add('hidden');
                fallback.classList.remove('hidden');
                fallback.classList.add('flex');
            });
        }
    });
</script>
}
