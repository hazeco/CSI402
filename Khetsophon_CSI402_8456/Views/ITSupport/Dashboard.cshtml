@{
    ViewData["Title"] = "ภาพรวมสถานะระบบ";
    Layout = "_ITSupportLayout";

    // Top-of-file Media & Content Configuration
    var pageHeader = new {
        Title = "ภาพรวมสถานะระบบ",
        Subtitle = "ข้อมูลจำลองสำหรับสาธิต — อัปเดตล่าสุด 09 ก.ย. 2569 เวลา 14:32 น.",
        RefreshText = "รีเฟรชข้อมูล"
    };

    var serverStats = new {
        ServerStatus = "ออนไลน์",
        ServerLatency = "ตอบสนอง 118 มิลลิวินาที",
        DbStatus = "ปกติ",
        DbBackup = "สำรองข้อมูลล่าสุด 03:00 น.",
        Uptime = "99.82%",
        Downtime = "ดาวน์ไทม์รวม 47 นาที",
        Errors = "3 ครั้ง",
        LastError = "ล่าสุด 13:47 น. — sync ล้มเหลว"
    };

    var recentEvents = new[] {
        new {
            Type = "warning",
            Title = "การซิงก์สต็อกล้มเหลว 1 ครั้ง กำลังลองใหม่อัตโนมัติ",
            Time = "13:47 น.",
            IconBg = "bg-[#FEF3C7] text-[#D97706]"
        },
        new {
            Type = "danger",
            Title = "พบความพยายามเข้าสู่ระบบผิดพลาดซ้ำจากบัญชีเดียวกัน 5 ครั้ง",
            Time = "11:20 น.",
            IconBg = "bg-[#FEE2E2] text-[#DC2626]"
        },
        new {
            Type = "success",
            Title = "สำรองฐานข้อมูลอัตโนมัติสำเร็จ",
            Time = "03:00 น.",
            IconBg = "bg-[#DCFCE7] text-[#16A34A]"
        },
        new {
            Type = "info",
            Title = "อัปเดตแจ้งเตือนสต็อกใกล้หมดสำหรับ 4 รายการ",
            Time = "02:15 น.",
            IconBg = "bg-[#DBEAFE] text-[#2F39A9]"
        },
        new {
            Type = "success",
            Title = "รีสตาร์ทบริการ POS หน้าร้านสำเร็จ (บำรุงรักษาตามแผน)",
            Time = "เมื่อวาน 22:00 น.",
            IconBg = "bg-[#DCFCE7] text-[#16A34A]"
        }
    };
}

<div class="space-y-6">
    <!-- Header Row (frame_9_19.png) -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
            <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
        </div>
        <button type="button" onclick="location.reload()"
                class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-bold px-4 py-2.5 rounded-xl shadow-2xs transition-colors cursor-pointer text-sm">
            <svg class="size-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
            <span>@pageHeader.RefreshText</span>
        </button>
    </div>

    <!-- 4 Stat Cards in a row (frame_9_19.png) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1 -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium">สถานะเซิร์ฟเวอร์</span>
                <span class="size-2 rounded-full bg-[#16A34A]"></span>
            </div>
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.ServerStatus</div>
            <div class="text-xs text-gray-400">@serverStats.ServerLatency</div>
        </div>

        <!-- Card 2 -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium">ฐานข้อมูล</span>
                <span class="size-2 rounded-full bg-[#16A34A]"></span>
            </div>
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.DbStatus</div>
            <div class="text-xs text-gray-400">@serverStats.DbBackup</div>
        </div>

        <!-- Card 3 -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium">Uptime 30 วันล่าสุด</span>
                <span class="size-2 rounded-full bg-[#2F39A9]"></span>
            </div>
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.Uptime</div>
            <div class="text-xs text-gray-400">@serverStats.Downtime</div>
        </div>

        <!-- Card 4 -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium">Error ใน 24 ชม.</span>
                <span class="size-2 rounded-full bg-[#D97706]"></span>
            </div>
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.Errors</div>
            <div class="text-xs text-gray-400">@serverStats.LastError</div>
        </div>
    </div>

    <!-- 2 Columns Grid: 30-Day Uptime & Recent Events (frame_9_19.png) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left 2 Cols: Uptime 30 วันล่าสุด -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-6">
            <div class="flex items-center justify-between flex-wrap gap-2">
                <h2 class="text-sm font-bold text-[#050315]">Uptime รายวัน (30 วันล่าสุด)</h2>
                <div class="flex items-center gap-4 text-xs">
                    <span class="flex items-center gap-1.5 text-gray-600 font-medium">
                        <span class="size-2 rounded-full bg-[#2F39A9]"></span> ปกติ (≥99.5%)
                    </span>
                    <span class="flex items-center gap-1.5 text-gray-600 font-medium">
                        <span class="size-2 rounded-full bg-[#D97706]"></span> สะดุด
                    </span>
                </div>
            </div>

            <!-- 30 Daily Bars Chart matching Figma -->
            <div class="h-48 flex items-end justify-between gap-1.5 pt-4">
                @for (int i = 1; i <= 30; i++)
                {
                    bool isIncident = (i == 6 || i == 20);
                    int height = isIncident ? 40 : 85 + ((i * 7) % 15);
                    <div class="flex-1 flex flex-col items-center h-full justify-end group cursor-pointer relative"
                         title="วันที่ @i: @(isIncident ? "98.2% (สะดุด)" : "100% (ปกติ)")">
                        <div class="w-full rounded-t-sm transition-all duration-200 @(isIncident ? "bg-[#D97706] hover:bg-[#B45309]" : "bg-[#2F39A9] hover:bg-[#202778]")"
                             style="height: @(height)%;"></div>
                    </div>
                }
            </div>

            <!-- X Axis Dates -->
            <div class="flex items-center justify-between text-xs text-gray-400 border-t border-gray-100 pt-2 font-mono">
                <span>11 ส.ค.</span>
                <span>25 ส.ค.</span>
                <span>09 ก.ย.</span>
            </div>
        </div>

        <!-- Right 1 Col: เหตุการณ์ล่าสุด -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
            <h2 class="text-sm font-bold text-[#050315]">เหตุการณ์ล่าสุด</h2>
            <div class="space-y-4">
                @foreach (var ev in recentEvents)
                {
                    <div class="flex items-start gap-3">
                        <div class="size-8 rounded-full @ev.IconBg flex items-center justify-center shrink-0 mt-0.5">
                            @if (ev.Type == "warning")
                            {
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                            }
                            else if (ev.Type == "danger")
                            {
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            }
                            else if (ev.Type == "info")
                            {
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                            }
                            else
                            {
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="text-xs font-semibold text-[#050315] leading-snug">@ev.Title</div>
                            <div class="text-[11px] text-gray-400 mt-0.5">@ev.Time</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
