<div class="space-y-6">
    <!-- Header (frame_9_21.png) -->
    <div>
        <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
        <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
    </div>

    <!-- Filter & Export Controls (frame_9_21.png) -->
    @* Form Parameters expected by Controller:
       [LogLevel: string, TimeRange: string]
    *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        <!-- Level Filters -->
        <div class="flex items-center gap-2">
            <span class="text-xs text-gray-500 font-medium">ระดับ:</span>
            <div class="flex items-center gap-1.5" id="logLevelButtons">
                <button type="button" onclick="filterLogLevel('all')" class="level-tab px-3.5 py-1.5 rounded-xl bg-[#2F39A9] text-white text-xs font-semibold cursor-pointer">
                    ทั้งหมด
                </button>
                <button type="button" onclick="filterLogLevel('ERROR')" class="level-tab px-3.5 py-1.5 rounded-xl bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 text-xs font-medium cursor-pointer shadow-2xs">
                    Error
                </button>
                <button type="button" onclick="filterLogLevel('WARNING')" class="level-tab px-3.5 py-1.5 rounded-xl bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 text-xs font-medium cursor-pointer shadow-2xs">
                    Warning
                </button>
                <button type="button" onclick="filterLogLevel('INFO')" class="level-tab px-3.5 py-1.5 rounded-xl bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 text-xs font-medium cursor-pointer shadow-2xs">
                    Info
                </button>
            </div>
        </div>

        <!-- Time Range Dropdown & Export Button -->
        <div class="flex items-center gap-2.5">
            <div class="relative">
                <select id="logTimeRange" class="appearance-none pr-8 pl-3.5 py-2 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-gray-700 shadow-2xs focus:outline-none">
                    <option value="24h">ช่วงเวลา: 24 ชั่วโมงล่าสุด</option>
                    <option value="7d">ช่วงเวลา: 7 วันล่าสุด</option>
                    <option value="30d">ช่วงเวลา: 30 วันล่าสุด</option>
                </select>
                <svg class="size-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>
            <button type="button" onclick="openExportLogsModal()" class="px-4 py-2 rounded-xl bg-[#2F39A9] hover:bg-[#242D87] text-white text-xs font-bold shadow-xs transition-colors cursor-pointer">
                ส่งออก .csv
            </button>
        </div>
    </div>

    <!-- Logs Monospace Table (frame_9_21.png) -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono min-w-[500px]" id="logsTable">
                <thead>
                    <tr class="border-b border-gray-100 text-left text-xs font-sans font-semibold text-gray-400 bg-[#FBFBFE]">
                        <th class="py-4 px-6 w-28">เวลา</th>
                        <th class="py-4 px-6 w-28 text-center">ระดับ</th>
                        <th class="py-4 px-6">ข้อความ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var log in logs)
                    {
                        <tr class="hover:bg-gray-50/70 transition-colors log-row cursor-pointer" data-level="@log.Level" onclick="openLogDetail('@log.Time', '@log.Level', '@log.Message')">
                            <!-- Timestamp -->
                            <td class="py-3.5 px-6 text-gray-400 whitespace-nowrap">
                                @log.Time
                            </td>

                            <!-- Level Badge -->
                            <td class="py-3.5 px-6 text-center">
                                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold @log.Class">
                                    @log.Level
                                </span>
                            </td>

                            <!-- Message Content -->
                            <td class="py-3.5 px-6 text-gray-800 leading-relaxed font-sans">
                                <span class="font-mono text-gray-900 font-semibold">@log.Message.Split(':')[0]:</span>
                                <span>@log.Message.Substring(log.Message.IndexOf(':') + 1)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer pagination / load more (frame_9_21.png) -->
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500 font-sans">
            <span>แสดง 12 จาก 96 รายการ ในช่วง 24 ชั่วโมงล่าสุด</span>
            <button type="button" class="px-4 py-1.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-semibold cursor-pointer">
                โหลดเพิ่มเติม
            </button>
        </div>
    </div>
</div>

