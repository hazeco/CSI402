@section Scripts {
    <script>
        let currentUnit = 'hour';

        function filterLogLevel(level) {
            const rows = document.querySelectorAll('.log-row');
            const buttons = document.querySelectorAll('.level-tab');

            buttons.forEach(btn => {
                if (btn.innerText.trim().toLowerCase() === (level === 'all' ? 'ทั้งหมด' : level).toLowerCase()) {
                    btn.className = 'level-tab px-3.5 py-1.5 rounded-xl bg-[#2F39A9] text-white text-xs font-semibold cursor-pointer';
                } else {
                    btn.className = 'level-tab px-3.5 py-1.5 rounded-xl bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 text-xs font-medium cursor-pointer shadow-2xs';
                }
            });

            rows.forEach(r => {
                if (level === 'all' || r.getAttribute('data-level') === level) {
                    r.style.display = '';
                } else {
                    r.style.display = 'none';
                }
            });
        }

        function openExportLogsModal() {
            document.getElementById('exportLogsModal')?.classList.remove('hidden');
        }

        function selectLogUnit(unit) {
            currentUnit = unit;
            const tabH = document.getElementById('tabHour');
            const tabD = document.getElementById('tabDay');
            const tabM = document.getElementById('tabMonth');
            const label = document.getElementById('labelUnitText');
            const valInput = document.getElementById('inputUnitVal');

            const activeClass = 'flex-1 py-2 rounded-xl text-xs font-bold text-[#2F39A9] bg-white shadow-xs transition cursor-pointer';
            const inactiveClass = 'flex-1 py-2 rounded-xl text-xs font-medium text-slate-500 hover:text-slate-800 transition cursor-pointer';

            tabH.className = inactiveClass;
            tabD.className = inactiveClass;
            tabM.className = inactiveClass;

            if (unit === 'hour') {
                tabH.className = activeClass;
                label.innerText = 'ชั่วโมง';
                valInput.value = '24';
            } else if (unit === 'day') {
                tabD.className = activeClass;
                label.innerText = 'วัน';
                valInput.value = '7';
            } else {
                tabM.className = activeClass;
                label.innerText = 'เดือน';
                valInput.value = '1';
            }
            updateCalculatedRange();
        }

        function updateCalculatedRange() {
            const val = document.getElementById('inputUnitVal')?.value || 24;
            const rangeBox = document.getElementById('calculatedRangeText');
            if (rangeBox) {
                if (currentUnit === 'hour') {
                    rangeBox.innerText = `08 ก.ย. 2567, 14:00 น. - 09 ก.ย. 2567, 14:00 น. (${val} ชั่วโมง)`;
                } else if (currentUnit === 'day') {
                    rangeBox.innerText = `02 ก.ย. 2567, 00:00 น. - 09 ก.ย. 2567, 23:59 น. (${val} วัน)`;
                } else {
                    rangeBox.innerText = `01 ส.ค. 2567 - 09 ก.ย. 2567 (${val} เดือน)`;
                }
            }
        }

        function openConfirmExportModal() {
            document.getElementById('exportLogsModal')?.classList.add('hidden');
            document.getElementById('confirmExportModal')?.classList.remove('hidden');
        }

        function closeConfirmExportModal() {
            document.getElementById('confirmExportModal')?.classList.add('hidden');
            document.getElementById('exportLogsModal')?.classList.remove('hidden');
        }

        function executeExportLogs() {
            document.getElementById('confirmExportModal')?.classList.add('hidden');
            document.getElementById('logsSuccessModal')?.classList.remove('hidden');
        }

        function openLogDetail(time, level, msg) {
            document.getElementById('detailTime').innerText = time;
            document.getElementById('detailLevel').innerText = level;
            document.getElementById('detailMsg').innerText = msg;
            document.getElementById('logDetailModal')?.classList.remove('hidden');
        }

        function closeAllModals() {
            document.querySelectorAll('[id$="Modal"]').forEach(m => m.classList.add('hidden'));
        }
    </script>
}
