        new { Time = "11:20:03", Level = "INFO", Class = "bg-[#DBEAFE] text-[#2F39A9]", Message = "auth.login: เข้าสู่ระบบสำเร็จ — teerapat.staff@friendhouse.local (พนักงานขาย)" },
