<div class="space-y-6">
    <!-- Header Row (frame_9_20.png) -->
    <div>
        <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
        <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
    </div>

    <!-- Blue Info Banner (frame_9_20.png) -->
    <div class="rounded-2xl bg-[#EFF6FF] border border-[#BFDBFE] p-4 flex items-center gap-3 text-xs text-[#1E40AF]">
        <svg class="size-4.5 shrink-0 text-[#2563EB]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span class="font-medium">@pageHeader.InfoBanner</span>
    </div>

    <!-- Search & Filter Controls (frame_9_20.png) -->
    @* Form Parameters expected by Controller:
       [SearchQuery: string, StatusFilter: string]
    *@
    <div class="flex flex-wrap items-center gap-3">
        <div class="relative flex-1 min-w-[320px]">
            <svg class="size-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="userSearch" placeholder="ค้นหาด้วยอีเมลหรือเบอร์โทร เช่น sarah@email.com หรือ 081-234-5678"
                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
        </div>

        <div class="relative">
            <select id="userStatusFilter" class="appearance-none pr-9 pl-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm font-medium text-gray-700 shadow-2xs focus:outline-none">
                <option value="all">สถานะบัญชีทั้งหมด</option>
                <option value="ปกติ">ปกติ</option>
                <option value="ถูกล็อก">ถูกล็อก</option>
            </select>
            <svg class="size-4 absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>

        <button type="button" onclick="searchUsers()" class="px-5 py-2.5 rounded-xl bg-[#2F39A9] hover:bg-[#242D87] text-white font-bold text-sm shadow-xs transition-colors cursor-pointer">
            ค้นหา
        </button>

        <button type="button" onclick="openAddUserModal()" class="px-5 py-2.5 rounded-xl bg-[#2F39A9] hover:bg-[#242D87] text-white font-bold text-sm shadow-xs transition-colors cursor-pointer ml-auto">
            เพิ่มผู้ใช้งาน
        </button>
    </div>

    <!-- Users Table (frame_9_20.png) -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[760px]" id="usersTable">
                <thead>
                    <tr class="border-b border-gray-100 text-left text-xs font-semibold text-gray-400 bg-[#FBFBFE]">
                        <th class="py-4 px-6">อีเมล</th>
                        <th class="py-4 px-6">เบอร์โทร</th>
                        <th class="py-4 px-6 text-center">สถานะบัญชี</th>
                        <th class="py-4 px-6">วันที่สมัคร</th>
                        <th class="py-4 px-6">เข้าสู่ระบบล่าสุด</th>
                        <th class="py-4 px-6 text-center">จัดการบัญชี</th>
                        <th class="py-4 px-6 text-right">การช่วยเหลือ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var u in users)
                    {
                        <tr class="hover:bg-gray-50/70 transition-colors user-row" data-status="@u.Status">
                            <!-- Email -->
                            <td class="py-4 px-6 font-semibold text-[#050315]">
                                @u.Email
                            </td>

                            <!-- Phone -->
                            <td class="py-4 px-6 text-gray-500 font-mono text-xs">
                                @u.Phone
                            </td>

                            <!-- Status Badge -->
                            <td class="py-4 px-6 text-center">
                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full @u.StatusClass">
                                    <span class="size-1.5 rounded-full currentColor bg-current"></span>
                                    @u.Status
                                </span>
                            </td>

                            <!-- Registration Date -->
                            <td class="py-4 px-6 text-gray-500 text-xs">
                                @u.RegDate
                            </td>

                            <!-- Last Login -->
                            <td class="py-4 px-6 text-gray-500 text-xs">
                                @u.LastLogin
                            </td>

                            <!-- Management Icons: Edit & Delete -->
                            <td class="py-4 px-6 text-center">
                                <div class="inline-flex items-center gap-1.5">
                                    <button type="button" onclick="openEditUserModal('@u.Email', '@u.Phone')"
                                            class="size-8 rounded-lg bg-blue-50 hover:bg-blue-100 text-[#2563EB] flex items-center justify-center transition cursor-pointer" title="แก้ไขข้อมูล">
                                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
                                        </svg>
                                    </button>
                                    <button type="button" onclick="openDeleteUserModal('@u.Email')"
                                            class="size-8 rounded-lg bg-red-50 hover:bg-red-100 text-[#DC2626] flex items-center justify-center transition cursor-pointer" title="ลบบัญชี">
                                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>

                            <!-- Support Action: Reset Password Button -->
                            <td class="py-4 px-6 text-right">
                                <button type="button" onclick="openResetPasswordModal('@u.Email')"
                                        class="px-3.5 py-1.5 rounded-lg bg-[#EFF6FF] hover:bg-blue-100 text-[#2563EB] text-xs font-semibold transition cursor-pointer">
                                    ช่วยรีเซ็ตรหัสผ่าน
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination (frame_9_20.png) -->
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
            <span>แสดง 8 จาก 214 บัญชี</span>
            <div class="flex items-center gap-2">
                <button type="button" class="px-4 py-1.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-semibold cursor-pointer">
                    ก่อนหน้า
                </button>
                <button type="button" class="px-4 py-1.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-semibold cursor-pointer">
                    ถัดไป
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODALS [64:2775] ==================== -->

<!-- 1. Add User Modal -->
<div id="addUserModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4 animate-scale-up">
        <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-[#050315]">เพิ่มผู้ใช้งานใหม่</h3>
            <button type="button" onclick="closeAllModals()" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="space-y-3">
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">บทบาท (Role)</label>
                <select id="newUserRole" onchange="toggleAvatarUpload(this.value)" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]">
                    <option value="Customer">Customer (ลูกค้า)</option>
                    <option value="Staff">Staff (พนักงานหน้าร้าน)</option>
                    <option value="Owner">Owner (เจ้าของร้าน)</option>
                    <option value="ITSupport">IT Support (ไอทีซัพพอร์ต)</option>
                    <option value="Accountant">Accountant (คนทำบัญชี)</option>
                </select>
            </div>
            <div id="nameFieldContainer" class="hidden">
                <label class="text-xs font-bold text-gray-700 block mb-1">ชื่อ-นามสกุล</label>
                <input type="text" placeholder="ชื่อ-นามสกุลเจ้าหน้าที่" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">อีเมล</label>
                <input type="email" placeholder="example@email.com" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">เบอร์โทรศัพท์</label>
                <input type="tel" placeholder="08X-XXX-XXXX" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">รหัสผ่านเริ่มต้น</label>
                <input type="password" placeholder="ตั้งรหัสผ่านชั่วคราว" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div id="avatarUploadContainer" class="hidden">
                <label class="text-xs font-bold text-gray-700 block mb-1">รูปประจำตัว (สำหรับเจ้าหน้าที่)</label>
                <input type="file" accept="image/*" class="w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:bg-gray-100" />
            </div>
        </div>
        <div class="flex items-center gap-2 pt-2">
            <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                ยกเลิก
            </button>
            <button type="button" onclick="submitNewUser()" class="flex-1 bg-[#2F39A9] hover:bg-[#242D87] text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                สร้างบัญชี
            </button>
        </div>
    </div>
</div>

<!-- 2. Edit User Modal -->
<div id="editUserModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4 animate-scale-up">
        <h3 class="text-base font-bold text-[#050315]">แก้ไขข้อมูลบัญชีผู้ใช้</h3>
        <div class="space-y-3">
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">อีเมล</label>
                <input type="email" id="editUserEmail" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs bg-gray-50" readonly />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">เบอร์โทรศัพท์</label>
                <input type="tel" id="editUserPhone" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">สถานะบัญชี</label>
                <select class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]">
                    <option value="Active">ปกติ</option>
                    <option value="Locked">ถูกล็อก</option>
                </select>
            </div>
        </div>
        <div class="flex items-center gap-2 pt-2">
            <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                ยกเลิก
            </button>
            <button type="button" onclick="submitEditUser()" class="flex-1 bg-[#2F39A9] hover:bg-[#242D87] text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                บันทึกการแก้ไข
            </button>
        </div>
    </div>
</div>

<!-- 3. Reset Password Confirmation / Validation Modal -->
<div id="resetPasswordModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 sm:p-7 shadow-2xl space-y-4 animate-scale-up text-center border border-slate-100">
        <div class="size-14 rounded-full bg-amber-50 text-amber-500 mx-auto flex items-center justify-center">
            <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>
        <div>
            <h3 class="text-lg font-bold text-[#050315]">ยืนยันการรีเซ็ตรหัสผ่าน</h3>
            <p class="text-xs font-mono font-bold text-[#2F39A9] mt-1 bg-indigo-50 py-1 px-3 rounded-lg inline-block" id="resetTargetEmail"></p>
            <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                คุณแน่ใจหรือไม่ว่าต้องการรีเซ็ตรหัสผ่านสำหรับบัญชีนี้? ระบบจะสร้างรหัสผ่านชั่วคราวใหม่บนหน้าจอทันที เพื่อให้เจ้าหน้าที่นำไปส่งมอบให้แก่ผู้ใช้งานด้วยตนเอง
            </p>
        </div>
        <div class="flex items-center gap-2 pt-2">
            <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                ยกเลิก
            </button>
            <button type="button" onclick="confirmResetPassword()" class="flex-1 bg-[#2F39A9] hover:bg-[#2F39A9]/90 text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                ยืนยันสร้างรหัส
            </button>
        </div>
    </div>
</div>

<!-- 3.1 Generated Password Display Modal (พอยืนยันเสร็จก็เจนรหัสเลย) -->
