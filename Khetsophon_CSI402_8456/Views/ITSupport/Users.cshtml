<!-- 4. Delete Confirmation Modal -->
<div id="deleteUserModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl space-y-4 animate-scale-up text-center">
        <div class="size-12 rounded-full bg-red-100 text-[#DC2626] mx-auto flex items-center justify-center">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </div>
        <div>
            <h3 class="text-base font-bold text-[#050315]">คุณแน่ใจว่าจะลบบัญชีนี้?</h3>
            <p class="text-xs font-mono text-gray-400 mt-1" id="deleteTargetEmail"></p>
            <p class="text-xs text-gray-500 mt-2">การลบบัญชีจะไม่สามารถกู้คืนได้ และประวัติที่เกี่ยวข้องจะถูกปิดการใช้งาน</p>
        </div>
        <div class="flex items-center gap-2 pt-2">
            <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                ยกเลิก
            </button>
            <button type="button" onclick="confirmDeleteUser()" class="flex-1 bg-[#DC2626] hover:bg-[#B91C1C] text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                ยืนยันลบ
            </button>
        </div>
    </div>
</div>

<!-- 5. Success Action Modal -->
<div id="actionSuccessModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center shadow-xl space-y-4 animate-scale-up">
        <div class="size-14 rounded-full bg-[#DCFCE7] text-[#16A34A] mx-auto flex items-center justify-center">
            <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>
        <div>
            <h3 class="text-base font-bold text-[#050315]" id="successModalTitle">ทำรายการสำเร็จ</h3>
            <p class="text-xs text-gray-500 mt-1" id="successModalDesc">ดำเนินการปรับปรุงข้อมูลเรียบร้อยแล้ว</p>
        </div>
        <button type="button" onclick="closeAllModals()" class="w-full bg-[#2F39A9] hover:bg-[#242D87] text-white py-2.5 rounded-xl font-bold text-sm shadow-xs cursor-pointer">
            ตกลง
        </button>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAvatarUpload(role) {
            const isCustomer = (role === 'Customer');
            document.getElementById('nameFieldContainer').className = isCustomer ? 'hidden' : '';
            document.getElementById('avatarUploadContainer').className = isCustomer ? 'hidden' : '';
        }

        function openAddUserModal() {
            document.getElementById('addUserModal')?.classList.remove('hidden');
        }

        function submitNewUser() {
            closeAllModals();
            showSuccess('สร้างผู้ใช้ใหม่สำเร็จ', 'เพิ่มบัญชีผู้ใช้งานใหม่เข้าสู่ระบบเรียบร้อยแล้ว');
        }

        function openEditUserModal(email, phone) {
            document.getElementById('editUserEmail').value = email;
            document.getElementById('editUserPhone').value = phone;
            document.getElementById('editUserModal')?.classList.remove('hidden');
        }

        function submitEditUser() {
            closeAllModals();
            showSuccess('แก้ไขสำเร็จ', 'บันทึกการแก้ไขข้อมูลบัญชีผู้ใช้เรียบร้อยแล้ว');
        }

        function openResetPasswordModal(email) {
            document.getElementById('resetTargetEmail').innerText = email;
            document.getElementById('resetPasswordModal')?.classList.remove('hidden');
        }

        function confirmResetPassword() {
            const targetEmail = document.getElementById('resetTargetEmail').innerText;
            closeAllModals();

            // Generate a secure temporary password
            const randomCode = Math.floor(1000 + Math.random() * 9000);
            const tempPass = `FH-Pass-${randomCode}`;

            document.getElementById('genUserEmailDisplay').innerText = targetEmail;
            document.getElementById('generatedPasswordBox').innerText = tempPass;
            document.getElementById('copyPassLabel').innerText = 'คัดลอก';

            document.getElementById('passwordGeneratedModal')?.classList.remove('hidden');
        }

        function copyGeneratedPassword() {
            const pass = document.getElementById('generatedPasswordBox').innerText.trim();
            navigator.clipboard.writeText(pass).then(() => {
                document.getElementById('copyPassLabel').innerText = 'คัดลอกแล้ว!';
                setTimeout(() => {
                    document.getElementById('copyPassLabel').innerText = 'คัดลอก';
                }, 2000);
            });
        }

        function openDeleteUserModal(email) {
            document.getElementById('deleteTargetEmail').innerText = email;
            document.getElementById('deleteUserModal')?.classList.remove('hidden');
        }

        function confirmDeleteUser() {
            closeAllModals();
            showSuccess('ลบสำเร็จ', 'ลบบัญชีผู้ใช้งานออกจากระบบเรียบร้อยแล้ว');
        }

        function showSuccess(title, desc) {
            document.getElementById('successModalTitle').innerText = title;
            document.getElementById('successModalDesc').innerText = desc;
            document.getElementById('actionSuccessModal')?.classList.remove('hidden');
        }

        function closeAllModals() {
            document.querySelectorAll('[id$="Modal"]').forEach(m => m.classList.add('hidden'));
        }

        function searchUsers() {
            const q = document.getElementById('userSearch')?.value.toLowerCase().trim();
            const status = document.getElementById('userStatusFilter')?.value;
            const rows = document.querySelectorAll('.user-row');

            rows.forEach(r => {
                const text = r.innerText.toLowerCase();
                const matchesQ = !q || text.includes(q);
                const matchesStatus = (status === 'all' || r.getAttribute('data-status') === status);
                r.style.display = (matchesQ && matchesStatus) ? '' : 'none';
            });
        }
    </script>
}
